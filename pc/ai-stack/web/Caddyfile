# =============================================================================
#  cloud.home.example.net -- Nextcloud, the live editor. 2026-09-06.
#
#  Jason: "live editor nextcloud with the ability to add a llm plugin like
#  Gemini or Hermes or claude."
#
#  NOT BEHIND forward_auth, and that is a decision rather than an omission.
#  Nextcloud has its own accounts, its own sharing model and its own
#  per-file permissions, and its mobile and desktop sync clients speak
#  WebDAV with app passwords -- none of which can complete a browser
#  sign-in redirect. Wrapping it in the household SSO would break sync on
#  every phone while adding nothing: it is already a login.
#
#  The household sign-in can still be the way in -- Nextcloud's user_oidc
#  app points at the auth service at /auth/oidc -- but that is configured
#  INSIDE Nextcloud, not by putting a second gate in front of it.
# =============================================================================
cloud.home.example.net {
	encode zstd gzip

	# Phones sync whole libraries and people upload real documents. The
	# default cap rejects both, as a bare 413 with no explanation.
	request_body {
		max_size 10GB
	}

	# The well-known redirects Nextcloud asks for. Without them its own
	# setup checks report the instance as misconfigured, and some desktop
	# clients refuse to connect at all.
	redir /.well-known/carddav /remote.php/dav 301
	redir /.well-known/caldav /remote.php/dav 301
	redir /.well-known/webfinger /index.php/.well-known/webfinger 301
	redir /.well-known/nodeinfo /index.php/.well-known/nodeinfo 301

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# Nextcloud sets its own frame rules and must embed Collabora; a
		# blanket DENY here leaves every document as a blank box.
		-X-Frame-Options
	}

	reverse_proxy nextcloud:80 {
		import appproxy
		# Big uploads and long occ jobs from the web UI. The default read
		# timeout cuts a slow upload off mid-file and the retry starts
		# again from nothing.
		transport http {
			read_timeout 900s
			write_timeout 900s
		}
	}

	log {
		output file /var/log/caddy/nextcloud.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# =============================================================================
#  office.home.example.net -- Collabora, the editing engine.
#
#  A SEPARATE HOSTNAME IS REQUIRED, not a preference. Collabora is embedded
#  in an iframe by Nextcloud and the two must be different origins, or the
#  isolation the editor relies on stops meaning anything.
#
#  Nobody visits this directly. It answers Nextcloud's WOPI callbacks, which
#  is why it carries no auth of its own -- the document tokens in those
#  callbacks are the credential, minted by Nextcloud per file, per person,
#  per session.
# =============================================================================
office.home.example.net {
	encode zstd gzip

	request_body {
		max_size 2GB
	}

	reverse_proxy collabora:9980 {
		import appproxy
		# The editor holds a websocket open for as long as a document is
		# open. A short timeout drops people mid-sentence, and the
		# reconnect loses whatever was not yet saved.
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}

	log {
		output file /var/log/caddy/collabora.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# =============================================================================
#  gym.home.example.net -- openGym. 2026-09-06.
#
#  Jason: "for my moms SSO casey and Jason for now I want to use this workout
#  docker ... I want to allow a persiant session across devices if they get
#  new apps."
#
#  BEHIND THE HOUSEHOLD GATE, and unlike Nextcloud that is the right call
#  here. openGym's own sign-in is passkeys, which are bound to ONE DEVICE:
#  a new phone means registering a new passkey, which is exactly the
#  "persistent session across devices" that was asked for and exactly what
#  passkeys cannot give. There are no sync clients to break -- it is a web
#  app and a web push subscription, both of which follow a browser session.
#
#  So forward_auth signs everyone in once, at this door, and openGym takes
#  that answer: the api reads X-Auth-Email and creates the profile the
#  first time somebody arrives (api/server.js, readSession). Mom opens the
#  page and it is hers, on her phone and on her tablet, with nothing to set
#  up on either.
#
#  WHAT MAKES THAT SAFE IS NOT THIS BLOCK. Port 8086 is on the LAN because
#  Caddy runs on the other machine, so anything in the house can reach
#  openGym directly and send whatever header it likes. The nginx inside the
#  web container blanks X-Auth-Email unless the connection came from
#  192.168.1.205 -- this machine. See web/nginx.conf in the openGym
#  checkout, and gitea-proxy.nginx.conf on the NUC, which does the same job
#  for the same reason.
#
#  Reachable on the LAN without the gate, it shows openGym's own passkey
#  login. That is the fallback for the day the gate is broken, and it is
#  why the nginx blanks the header rather than refusing the request.
# =============================================================================
#  music. -- Navidrome on the Pi.  192.168.1.69:4533
#
#  The library was reachable only at http://192.168.1.69:4533 on the LAN --
#  no route, no card, nothing on the site saying it existed. 117,321 files
#  and 223 GB, including the 80.7 GB of Jason's Music and the 45.5 GB YouTube
#  crate moved to the NAS on 2026-09-14/15, all of it unplayable from a phone
#  off the wifi.
#
#  NO SECOND LOGIN. Navidrome was already configured for header auth and had
#  simply never been wired to anything:
#      ND_EXTAUTH_USERHEADER=X-Auth-Email
#      ND_EXTAUTH_TRUSTEDSOURCES=192.168.1.0/24
#  so forward_auth's X-Auth-Email is accepted as the identity and the house
#  sign-in covers it, the same way Paperless and Gitea work.
#
#  WHY /rest/* IS NOT GATED, and why that is not a hole. That is the Subsonic
#  API, which is how a phone client (DSub, Symfonium, play:Sub) plays music.
#  Those apps cannot perform a cookie sign-in flow, so forward_auth would not
#  secure them -- it would simply make them fail to connect. The Subsonic API
#  authenticates every request itself with a username and a salted token, so
#  the endpoint is protected by Navidrome rather than by Caddy. Same shape as
#  the /paperless/share/* exception above: an endpoint whose own auth model
#  is the right one is left to use it.
#
#  Streaming needs: long timeouts, because a client holds one connection for
#  the length of a track and a phone on a train holds it a lot longer than
#  that. No compression -- audio is already compressed and buffering it would
#  break seeking.
# =============================================================================
music.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	# Outside the gate, or the sign-in redirect loops on its own callback.
	handle /__sso* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	# The Subsonic API. Authenticated by Navidrome, not by Caddy -- see above.
	# X-Auth-Email is stripped deliberately: leaving Caddy's last-seen
	# identity on an API request would let a phone client act as whoever
	# signed in on the browser most recently.
	handle /rest/* {
		reverse_proxy 192.168.1.69:4533 {
			header_up -X-Auth-Email
			header_up X-Forwarded-Host {host}
			transport http {
				read_timeout 6h
				write_timeout 6h
			}
		}
	}

	# Everything else -- the web player -- behind the house sign-in.
	handle {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
			header_up X-Forwarded-Host {host}
		}
		reverse_proxy 192.168.1.69:4533 {
			header_up X-Forwarded-Host {host}
			transport http {
				read_timeout 6h
				write_timeout 6h
			}
		}
	}
}

