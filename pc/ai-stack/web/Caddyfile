	# LD_CONTEXT_PATH before it was removed. Blank-page bug this fixes:
	# without DOZZLE_BASE, Dozzle emitted root-absolute asset paths
	# (/assets/...) that never reached it once loaded under a /logs prefix.
	redir /logs /logs/ 308
