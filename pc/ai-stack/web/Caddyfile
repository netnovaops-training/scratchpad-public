	# --- /special: the room camera -------------------------------------------
	# "handle", NOT "handle_path". Frigate is told its own base path with
	# FRIGATE_BASE_PATH and builds its links to match, so the prefix has to
	# survive the proxy rather than be stripped off it -- same arrangement as
	# /logs and /scratch.
	#
	# X-Ingress-Path is the half people miss. Frigate documents it as the
	# PREFERRED way to set the base path, and its API endpoints use it even
	# when the environment variable is also set. Both, or some routes break.
	#
	# GATED, and this one deserves it more than most: it is a camera in a
	# bedroom. Narrow it to yourself on /admin/people -- it defaults
	# unrestricted like every new app until somebody does that by hand.
	redir /special /special/ 308
	handle /special/* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy 192.168.1.86:5001 {
			import appproxy
			header_up X-Ingress-Path /special
			# Who Caddy just authenticated. Frigate is configured to trust this
			# instead of showing its own login page -- see proxy.header_map in
			# its config. Set here, so a browser cannot supply its own.
			header_up X-Forwarded-User {http.request.header.X-Auth-Email}
		}
	}

