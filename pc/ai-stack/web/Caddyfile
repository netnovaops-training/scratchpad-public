			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy kitchen:8003 {
			import appproxy
			header_up X-Forwarded-Prefix /kitchen
		}
	}

	# --- the family photos, under /legacy ------------------------------------
	# WAS peeweelegacy.ddns.net. Static files, so this needed no app changes.
	#
	# Still not indexed: robots.txt at the site root covers the whole host, and
	# this header says no again for the crawlers that ignore robots.txt.
	# Anyone with the link can look; nobody stumbles across it in a search.
	# THIS USED TO BE `file_server browse` AND THAT WAS A MISTAKE.
	# It served ../Legacy as a public directory listing: no password, and every
	# file in it enumerable and downloadable by anyone who had the link. The
	# comment here used to argue that a plain listing was "genuinely the right
	# interface for a pile of family photos". It is not, once the pile is
	# hundreds of 9MB photos of your family.
	#
	# Now a Rust app serves it: a password, and ONLY the folders named in
	# legacy.json exist as URLs. Caddy no longer mounts the photo folder at
	# all, so even a routing mistake here cannot expose it.
	redir /legacy /legacy/ 308
	handle_path /legacy/* {
		reverse_proxy legacy:8012 {
			import appproxy
			header_up X-Forwarded-Prefix /legacy
		}
	}

	# --- the admin, under {$ADMIN_PATH} --------------------------------------
	# Uploads JSON site data. It is the only thing in the stack that can WRITE
	# what the sites display, so it is the one path here worth being careful
	# about.
	#
	# WHY THE PATH IS A VARIABLE
	# It defaults to /admin, which every scanner on the internet tries within
	# minutes of a host appearing in certificate transparency logs. They will
	# never get past the password, but they will fill your logs and they will
	# trip the lockout -- which locks YOU out too, because the real client IP
	# is unavailable behind Docker Desktop's NAT (see the note in `appproxy`),
	# so the lockout has to be global to be honest.
	#
	# Setting ADMIN_PATH in .env to something unguessable, e.g.
	#     ADMIN_PATH=/admin-a7f3c2e9
	# means scanners never find it, so they never trip the lockout, so the
	# lockout is there for an actual attacker rather than for background
	# noise. Same reasoning as the Koalendar webhook path above. It is not a
	# password and is not a substitute for one -- the password is still what
	# protects this. It just keeps the noise off.
	#
	# handle_path strips the prefix, so the app itself always sees "/" and does
	# not need to know where it is mounted. Its links are all relative, which
	# is what makes that work.
	# --- the tables editor, under {$ADMIN_PATH}/tables -----------------------
	# MUST COME BEFORE the {$ADMIN_PATH}/* block below. Caddy tries handle
	# blocks in the order they are written, not longest-match-first, so putting
	# this second would mean /admin/* swallowed it and the editor was never
	# reachable at all.
	#
	# It has no password of its own. forward_auth asks the Rust admin whether
	# this visitor is signed in, and a "no" is answered with the admin's own
	# sign-in redirect - so the argon2 password next door is the only door, and
	# Streamlit never sees a byte from anyone who has not come through it.
	handle {$ADMIN_PATH:/admin}/tables* {
		forward_auth admin:8011 {
			uri /verify
		}
		request_body {
			max_size 8MB
		}
		reverse_proxy tables:8501 {
			# DELIBERATELY NOT `import appproxy` HERE, and this is the fix for
			# a real bug: the page loaded, every asset returned 200, and the
			# websocket returned 400, so Streamlit sat at "Please wait..."
			# forever and the app looked broken when it was fine. A handshake
			# straight at the container answered 101 Switching Protocols.
			#
			# The cause was TWO `transport http` blocks in one reverse_proxy --
			# one arriving via the snippet, one declared here for the long
			# timeout a websocket needs. This is the only route on the machine
			# that needs a different transport from the snippet, so it spells
			# out what it needs instead of importing and then contradicting.
			#
			# The Connection and Upgrade header_up lines are gone too. They are
			# Caddy v1 advice; v2 proxies websockets natively and setting them
			# by hand only creates a second opinion about the same header.
			header_up -X-Real-IP
			header_up -True-Client-IP
			header_up -X-Client-IP
			header_up -X-Originating-IP
			header_up -X-Forwarded-Host
			header_up -X-Host
			header_up -Forwarded
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			# ZERO, not 300s. A Streamlit websocket is open for as long as the
			# tab is, and a read timeout closes it mid-session -- which shows
			# up as the page going dead after a few minutes rather than as an
			# error anybody could act on.
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	redir {$ADMIN_PATH:/admin} {$ADMIN_PATH:/admin}/ 308
	handle_path {$ADMIN_PATH:/admin}/* {
		request_body {
			# Matches ADMIN_MAX_UPLOAD_MB. Caddy rejects anything larger before
			# it ever reaches the app, so a huge upload cannot tie up the
			# container's memory.
			max_size 8MB
		}
		reverse_proxy admin:8011 {
			import appproxy
			# WHERE THE APP LIVES, told to it explicitly.
			#
			# handle_path strips the prefix, so without this the app sees "/people"
			# while the browser sees "/admin/people" - and every link it writes is
			# relative to the wrong thing. It used to build relative links to cope,
			# which broke the moment a POST rendered a page: the browser's URL
			# became /admin/people/add, and the next form on that page resolved to
			# /admin/people/people/password. A 404 that only appeared on the SECOND
			# submit, which reads as anything but a URL problem.
			#
			# Passed as a header rather than baked in, so changing ADMIN_PATH moves
			# the app without rebuilding it.
			header_up X-Forwarded-Prefix {$ADMIN_PATH:/admin}
		}
	}

	# --- the landing page (Rust) ---------------------------------------------
	# This used to be `php_fastcgi php:9000`. It's now a proxy to the `landing`
	# container. To roll back: put the php_fastcgi block back, and start with
	# `--profile php-fallback`.
	handle / {
		reverse_proxy landing:8010 {
			import appproxy
		}
	}
	handle /jason/* {
		reverse_proxy landing:8010 {
			import appproxy
		}
	}

	# --- /jason with no trailing slash ---------------------------------------
	# `handle /jason/*` does NOT match a bare `/jason`. Without this line that
	# request falls through to the catch-all below and 404s, even though the
	# landing app has a route for it.
	redir /jason /jason/ 308

	# --- everything else: static files ---------------------------------------
	# ORDER MATTERS. This catch-all must come last, or it swallows /casey and
	# /mama before they're ever matched. That's the exact bug the old Pi
	# Caddyfile warned about.
	#
	# THE ROOT HERE USED TO BE /srv/www, WHICH WAS THE WHOLE www FOLDER.
	# That folder contains ai-stack, and ai-stack contains .env -- the Twilio
	# auth token, the LiteLLM master key, every API key. `file_server` will not
	# LIST a directory without `browse`, but it will happily SERVE any path you
	# name, and /ai-stack/.env is a name anyone can guess. It also exposed
	# Casey/app, Booking/app and Mom in full.
	#
	# So the root is now a folder that exists only to be public. Nothing else on
	# this machine is reachable through the web server. If you want a file on
	# the internet, put it in ai-stack\web\public\ and it appears at the root of
	# the site; nothing outside that folder can leak, because nothing outside it
	# is mounted.
	# --- the app download ----------------------------------------------------
	# ONE FILE, ONE URL, FOREVER. Versioned filenames existed only to defeat
	# browser caching, and they cost a permanent link: every release moved the
	# URL, and a bookmark from last week 404s. This solves the caching part
	# properly instead -- no-cache means "revalidate before reusing", not
	# "never store", so a repeat download is a 304 when nothing changed and
	# the new bytes when something did.
	#
	# The version is inside the APK and printed on the sign-in screen, which
	# is the honest place for it: the filename was never evidence of what
	# actually installed.
	handle /apps/* {
		root * /srv/public
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}

	handle {
		root * /srv/public

		# Defence in depth, not the main defence. There is no PHP interpreter in
		# the chain any more, so a .php file would be served as PLAIN TEXT.
		@php path *.php
		respond @php 404

		# Dotfiles: .env, .git, .htpasswd. Nothing should ever be in the public
		# folder starting with a dot, and if something is, this is the line that
		# means it was a mistake rather than an incident.
		@dot path */.*
		respond @dot 404

		file_server
	}
}

# =============================================================================
#  example.org:9443 â€” Mealie, the recipe library
#
#  WHY THIS IS A PORT AND NOT A PATH
#  ---------------------------------
#  It is the one app here that could not go under a prefix. Mealie's frontend
#  requests its assets from absolute "/..." paths, so behind `handle_path
#  /recipes/*` the HTML loads and every script, stylesheet and API call 404s:
#  a blank page with a console full of errors. That is not a proxy setting
#  anyone has missed -- upstream has declined subpath hosting for years, and
#  the workarounds all involve rewriting the app's built assets.
#
#  So it needs the root of something. The two ways to give it one are a second
#  hostname or a second port, and a port needs no new DNS record and no change
#  to the dynamic-DNS updater. Caddy already holds a certificate for
#  example.org, and a certificate covers the NAME, not the port --
#  so https on 9443 is trusted with nothing extra to obtain or renew.
#
#  THE ONE THING THIS COSTS YOU: port 9443 must be forwarded on the router,
#  alongside 80 and 443, or this is LAN-only. Let's Encrypt does not care --
#  the certificate is issued over port 80 for the hostname and simply reused
#  here -- so a forgotten forward shows up as "works at home, not on mobile
#  data", never as a certificate error.
# =============================================================================
#  RETIRED 2026-09-06 -- Authentik on :9443
#
#  Four containers (server, worker, its own postgres, its own redis) for an
#  identity provider with two applications configured: Stirling-PDF and
#  Immich. Measured that day, BOTH authenticate somewhere else:
#      stirling-pdf  SECURITY_OAUTH2_ISSUER   = .../auth/oidc
#      immich        oauth.issuerUrl          = .../auth/oidc  (enabled)
#  Both point at this house's own Rust auth service. Authentik's copies were
#  stale. Its last event of any kind was 2026-08-31; thirty-day totals were
#  four logins and seven failures, which is nobody.
#
#  Containers stopped, not removed -- the database volume is untouched, so
#  the two application definitions are still there if it is ever wanted as a
#  fallback provider. It was not wired to be one, which is why it was cost
#  without cover.
# =============================================================================
## =============================================================================
# example.org:9443 {
# 	import common
#
# 	# =========================================================================
# 	#  authentik — the identity provider
# 	#
# 	#  WAS MEALIE UNTIL 2026-08-28. Mealie's container died three days earlier
# 	#  (exit 137) and nothing noticed: this port kept answering, kept asking
# 	#  for a login, and forwarded every visitor to a backend that was gone.
# 	#  Jason confirmed he had moved off it. So the router forward already
# 	#  existed, the certificate for this hostname already covered it, and the
# 	#  port cost nothing to reclaim.
# 	#
# 	#  A PORT AND NOT A PATH, because Authentik expects to own the root of a
# 	#  hostname and has no subpath deployment -- the same wall DocuSeal and
# 	#  Uptime Kuma hit. scratch-map was forkable; this is not.
# 	#
# 	#  NO forward_auth HERE, DELIBERATELY, AND THIS IS THE EASY THING TO GET
# 	#  WRONG. Every other site block on this file gates itself behind the auth
# 	#  service. This one must not: it IS the login. Putting a gate in front of
# 	#  the sign-in page is how an estate locks itself out of itself, and the
# 	#  Rust auth service cannot authenticate for the thing meant to replace it.
# 	#  Authentik does its own authentication, and its own authorization, from
# 	#  the admin panel at /if/admin/.
# 	# =========================================================================
# 	reverse_proxy authentik-server:9000 {
# 		import appproxy
# 		# Authentik reads these to build absolute URLs and to record who was
# 		# actually at the other end. Without the real client address every
# 		# login in the audit log reads as coming from the proxy, and its own
# 		# brute-force protection counts the whole house as one attacker.
# 		header_up X-Forwarded-Proto https
# 		header_up X-Forwarded-Host {host}
# 		header_up X-Real-IP {remote_host}
# 	}
# }

# =============================================================================
#  example.org:9444 — OTOBO, the ticket queue console
#
#  Own port, same as Mealie/Peppermint before it, and the same reason: keep
#  this off the main domain's path space so nothing about /_next-style asset
#  paths or Perl script paths can collide. OTOBO's own URLs already start
#  with /otobo/ (index.pl, customer.pl, nph-genericinterface.pl) so it would
#  probably survive a path prefix too, but there is no upside to testing that
#  when :9444 already works, has TLS, and is already forwarded on the router.
#
#  NO SSO HAND-OFF, same choice as Peppermint had. OTOBO keeps its own login.
#  forward_auth below is the first door: you must already be signed into the
#  site, THEN OTOBO asks for its own agent password. A bare OTOBO login with
#  no gate in front is a password-guessing target the moment it is reachable
#  from anywhere but this PC.
#
#  FORWARD THIS PORT ON THE ROUTER TOO if you want it reachable off your home
#  network, same as 9443.
# =============================================================================
# DISABLED 2026-08-28, Jason's call: "i dont want that ticket system".
# OTOBO is behind a compose profile now (docker-compose.web.yml) and nothing
# listens on 5000, so this block would answer every request with a 502.
# Commented rather than deleted: the port is still forwarded on the router
# and this is the record of what used to answer on it. To bring it back,
# start the stack with --profile otobo and uncomment the block below.
#
# WORTH DOING SEPARATELY: close 9444 on the router. A forwarded port with
# nothing behind it is not dangerous today, but it is an invitation to
# forget what it was for.
# example.org:9444 {
# 	import common
#
# 	redir /auth /auth/ 308
# 	handle_path /auth/* {
# 		reverse_proxy auth:8013 {
# 			import appproxy
# 		}
# 	}
#
# 	handle {
# 		forward_auth auth:8013 {
# 			uri /verify
# 			copy_headers X-Auth-Email
# 			# THE ORIGINAL PATH, NOT THE STRIPPED ONE.
# 			#
# 			# handle_path removes the prefix before this runs, so Caddy's
# 			# own X-Forwarded-Uri arrived at the auth service as "/" for
# 			# every app in a handle_path block. Two things broke, and only
# 			# the harmless one was visible:
# 			#
# 			#  1. Signing in dumped you at the site root instead of the
# 			#     page you asked for -- /auth/?next=/ rather than
# 			#     ?next=/git/.
# 			#  2. MUCH WORSE: app_for_uri() decides per-app permissions by
# 			#     matching that path. Given "/" it matched nothing and
# 			#     returned None, which means "being on the sign-in list is
# 			#     the only gate" -- so the per-app toggles on /admin/people
# 			#     did nothing at all for /git, /portainer, /status, /tools
# 			#     and /pdf. Anyone who could sign in could reach Portainer,
# 			#     which holds the Docker socket and is root-equivalent.
# 			#
# 			# Proven by the one block that does NOT strip: /logs uses
# 			# `handle` and correctly produced ?next=/logs/ while every
# 			# handle_path app produced ?next=/ (measured 2026-08-28).
# 			#
# 			# orig_uri is the path as the browser sent it, before any
# 			# rewrite -- which is what both the redirect and the permission
# 			# check have always meant to use.
# 			header_up X-Forwarded-Uri {http.request.orig_uri}
# 		}
#
# 		reverse_proxy otobo:5000 {
# 			import appproxy
# 		}
# 	}
# }

# =============================================================================
#  example.org:9445 — Tandoor Recipes (being evaluated to replace
#  Mealie, see .env.example's TANDOOR section for why)
#
#  Own port, same reasoning as Mealie and OTOBO: a Django app with its own
#  asset paths, no upside to testing whether it tolerates a path prefix when
#  a free port is right there. :9443 is Mealie, :9444 is OTOBO, :9445 is next.
#
#  SSO HAND-OFF NOW WIRED, same shape as Mealie's own block above. Tandoor's
#  auth turned out to be a Django session cookie (`sessionid`), not a bearer
#  token -- see Kitchen/app/handoff_tandoor.py's docstring for how that was
#  confirmed and why. /kitchen/library now mints a Tandoor session instead of
#  a Mealie one, so this is the same @needs_handoff pattern with the cookie
#  name swapped.
#
#  FORWARD PORT 9445 ON THE ROUTER TOO if you want it reachable off the LAN.
# =============================================================================
example.org:9445 {
	import common

	redir /auth /auth/ 308
	handle /auth/* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	# --- kitshn (and any other real Tandoor client), unauthenticated at
	# THIS layer, on purpose -----------------------------------------------
	# Jason's own request (2026-08-24): set up the real kitshn app
	# (play.google.com/store/apps/details?id=de.kitshn.android) for Mama
	# and Casey. A native app has no way to hold the site's own SSO cookie --
	# it logs in directly against Tandoor's own real accounts (Settings >
	# API Tokens, or its normal username/password), which is a perfectly
	# real gate on its own. Putting forward_auth in front of THAT login
	# request would 401 it before Tandoor ever saw it -- confirmed live
	# this session that forward_auth gates the whole port unconditionally,
	# and the @needs_handoff redirect below only fires for a browser
	# (`Accept: text/html`), never a JSON API call, so a native app would
	# have gotten forward_auth's bare 401 with no way to recover from it.
	# /media/* is exempted too -- recipe/step photos the app needs to
	# actually show a recipe, same reasoning. Tandoor's own account system
	# (already real, already provisioned for Jason/Mama/Casey) is what
	# decides who sees what through here, exactly as it's designed to.
	handle /api/* {
		request_body {
			max_size 64MB
		}
		reverse_proxy tandoor:80 {
			import appproxy
		}
	}
	handle /media/* {
		reverse_proxy tandoor:80 {
			import appproxy
		}
	}

	handle {
		# Recipe photos again -- same allowance as Mealie's own block.
		request_body {
			max_size 64MB
		}

		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			# THE ORIGINAL PATH, NOT THE STRIPPED ONE.
			#
			# handle_path removes the prefix before this runs, so Caddy's
			# own X-Forwarded-Uri arrived at the auth service as "/" for
			# every app in a handle_path block. Two things broke, and only
			# the harmless one was visible:
			#
			#  1. Signing in dumped you at the site root instead of the
			#     page you asked for -- /auth/?next=/ rather than
			#     ?next=/git/.
			#  2. MUCH WORSE: app_for_uri() decides per-app permissions by
			#     matching that path. Given "/" it matched nothing and
			#     returned None, which means "being on the sign-in list is
			#     the only gate" -- so the per-app toggles on /admin/people
			#     did nothing at all for /git, /portainer, /status, /tools
			#     and /pdf. Anyone who could sign in could reach Portainer,
			#     which holds the Docker socket and is root-equivalent.
			#
			# Proven by the one block that does NOT strip: /logs uses
			# `handle` and correctly produced ?next=/logs/ while every
			# handle_path app produced ?next=/ (measured 2026-08-28).
			#
			# orig_uri is the path as the browser sent it, before any
			# rewrite -- which is what both the redirect and the permission
			# check have always meant to use.
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}

		# --- the sign-in hand-off ---------------------------------------------
		# REPOINTED 2026-09-04. This used to send a cookie-less browser to
		# https://example.org/kitchen/library, where Kitchen logged in
		# to Tandoor on their behalf using a per-person password it keeps in its
		# own tandoor_users table (Kitchen/app/handoff_tandoor.py).
		#
		# THAT MECHANISM IS DEAD, and not because of this change: the accounts it
		# holds passwords for no longer exist. Tandoor had been silently running
		# on SQLite, in a file inside its own container, on no volume -- see
		# DB_ENGINE in docker-compose.web.yml for the full account -- and the
		# 2026-08-31 restart took every account and every recipe with it.
		#
		# Tandoor now signs people in against the household's own OIDC issuer,
		# so the hand-off is one hop instead of three: this redirect starts the
		# flow, SOCIALACCOUNT_LOGIN_ON_GET makes allauth skip its confirmation
		# page, and the issuer already holds the signed-in cookie and bounces
		# straight back. No password is stored anywhere for it.
		#
		# `not path /accounts/*` IS LOAD-BEARING. Without it this matcher eats
		# the very flow it is trying to start: /accounts/oidc/household/login/
		# and its /login/callback/ are both HTML GETs that arrive with no
		# sessionid cookie -- the callback is what SETS that cookie. The symptom
		# is a redirect loop that never reaches Tandoor at all.
		@needs_handoff {
			not header_regexp Cookie "sessionid="
			not path /accounts/*
			method GET
			header Accept *text/html*
		}
		redir @needs_handoff /accounts/oidc/household/login/?process=login&next={uri} 302

		reverse_proxy tandoor:80 {
			import appproxy

			# Tandoor's own AI import calls LiteLLM the same way Mealie's does
			# -- same long-read-timeout reasoning as the Mealie block above.
		}
	}
}

# =============================================================================
#  garden.example.org -- a SEPARATE project, added 2026-08-28. See
#  ~/.claude/plans/happy-yawning-wilkes.md for the full phased rewrite plan.
#
#  DIFFERENT HOSTNAME, not a path under example.org, so this is
#  its own top-level site block -- Caddy already handles multi-domain TLS
#  via SNI (same mechanism that already serves example.org),
#  and this rides the exact same NUC-relay infrastructure with zero new
#  router ports: the router already forwards 80/443 to the NUC's
#  haproxy-relay, which already forwards straight through to THIS Caddy
#  regardless of which hostname the request is for.
#
#  Phase 1 only right now (see the plan) -- a skeleton Rust app on the NUC
#  with just /healthz proving DNS -> relay -> Caddy -> app -> the imported
#  MariaDB works end to end. No forward_auth here yet: this is a public
#  garden site, not a household admin tool -- auth only gates write paths,
#  once those exist (phase 3).
# =============================================================================
garden.example.org {
	# The Streamlit plant-admin tool. nginx does basic auth (its own
	# .htpasswd) and proxies to Streamlit, which is configured with
	# baseUrlPath="streamlit" so the prefix stays intact -- hence
	# `handle`, NOT `handle_path`.
	#
	# BEHIND THE HOUSEHOLD SIGN-IN SINCE 2026-09-19, on Jason's
	# instruction. The site around it stays public -- catalogue, gallery
	# and blog are for anybody -- but the admin tool is not part of that,
	# and it was previously protected by a basic-auth password and
	# nothing else.
	#
	# TWO GATES IN SERIES, ON PURPOSE AND TEMPORARILY. The basic-auth
	# sidecar is still there: you pass the household door, then the
	# password you already know. Two gates cannot lock anybody out that
	# one would not, and it is the same ordering that just worked for
	# connection.php -- prove the new door in anger, THEN remove the old
	# one. Retiring the sidecar is on the garden's TODO.
	#
	# WEBSOCKETS: Streamlit holds one open for the life of the tab, and
	# forward_auth runs on the upgrade request like any other. An expiring
	# session therefore drops the socket and the page reconnects through
	# sign-in. That is correct, and it is worth knowing before somebody
	# reports it as the tool going dead.
	# --- /beds: where Robin draws his garden ------------------------------
	# The bed planner (garden-ingest /plan). On HIS hostname, not the admin
	# one, because it is his garden -- the same service already answers at
	# example.org/garden-review for the approval queue.
	#
	# redir THEN handle_path, and the pair matters. handle_path strips
	# /beds, so the service sees /plan and the page's own fetches land back
	# on /beds/api/... which strips to /api/... The page derives that prefix
	# from its own URL, so this mounts anywhere without a code change.
	#
	# The service checks the address AGAIN on its own side: being signed in
	# to the household is not the same as being allowed to redraw a garden.
	# /checkup rides the same mount as /beds: one handle_path prefix, and
	# both pages derive their own base from their URL. A second block would
	# be a second thing to keep in step for no gain.
	redir /checkup /beds/checkup 308
	# /spend rides the same mount for the same reason: the receipts
	# page derives its own base from its URL, so it needs a short way in
	# and nothing else.
	redir /spend /beds/spend 308
	# /diagnose -- point the camera at a plant. Same mount, same
	# reason: one page both the site and Robin's app use.
	redir /diagnose /beds/diagnose 308
	redir /tagscan /beds/tag 308
	redir /wiki-queue /beds/wiki-queue 308
	redir /beds /beds/plan 308
	handle_path /beds* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		# RETIRED 2026-10-25: Robin's Garden is not served from here.
		respond "Robin's Garden moved." 410
	}

	handle /streamlit* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		# RETIRED 2026-10-25: Robin's Garden is not served from here.
		respond "Robin's Garden moved." 410
	}

	# --- GARDEN_SSO (2026-09-18) --------------------------------------
	# The household sign-in, on this hostname too. forward_auth's redirect
	# is relative, so somebody sent to /auth/ must find it HERE rather than
	# on example.org.
	redir /auth /auth/ 308
	handle /auth/* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	# THE SITE STAYS PUBLIC. Only the door marked "sign in" runs
	# forward_auth. Everything else -- catalogue, gallery, blog, the
	# dashboard -- is reachable by anybody, which is what it has always
	# been and what Jason asked to keep.
	#
	# A visitor who hits /sso-login is bounced to the household sign-in,
	# comes back with a verified X-Auth-Email, and connection.php turns
	# that into a session (see its GARDEN_SSO_BLOCK). The old password
	# form still works underneath while this is proven.
	@ssologin path /sso-login /sso-login/*
	handle @ssologin {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		# RETIRED 2026-10-25: Robin's Garden is not served from here.
		respond "Robin's Garden moved." 410
	}

	# Everything else: the original PHP site (php:8.3-apache on the NUC),
	# restored 2026-08-28 rather than rewritten -- see the long note on
	# garden-php in share/nuc-homelab/docker-compose.yml. The Rust
	# port that briefly served this hostname is still running on :8021 for
	# comparison, but is no longer wired to anything.
	handle {
		# A CLIENT MAY NOT CLAIM TO BE ANYBODY. connection.php trusts
		# X-Auth-Email, so the public half of the site must never be able
		# to carry one in from outside.
		request_header -X-Auth-Email
		# RETIRED 2026-10-25: Robin's Garden is not served from here.
		respond "Robin's Garden moved." 410
	}
}

# =============================================================================
#  example.org:9444 — DocuSeal, the document signing tool
#
#  WHY A PORT AND NOT A PATH. DocuSeal cannot be served from a subpath: it
#  ignores RAILS_RELATIVE_URL_ROOT (tested -- /pdf-sign/ returned its own 404)
#  and stripping the prefix breaks it the other way, because its assets are
#  root-absolute. At the root of a port it has no prefix to cope with and
#  simply works.
#
#  WHY THIS COSTS NOTHING. A TLS certificate is issued per HOSTNAME, not per
#  port, so Caddy's existing certificate for example.org serves
#  this without a new DNS entry, a new hostname, or a paid domain. That
#  matters here: the No-IP account is the free tier.
#
#  9444 WAS OTOBO'S. Otobo was retired on 2026-08-28 and this port went spare,
#  which is the only reason this arrangement is free -- the router forward
#  already existed. It needs re-opening: external 9444 -> 192.168.1.86.
#
#  The relay's ft_otobo frontend on the NUC is renamed to ft_docuseal to match.
# =============================================================================
example.org:9444 {
	import common

	# --- sign in, ON THIS PORT TOO ------------------------------------------
	# Same reasoning as the :9443 block: forward_auth's redirect is relative,
	# so an unauthenticated arrival here is sent to
	# https://example.org:9444/auth/ . Without this block that path
	# falls through to DocuSeal, which answers 404 -- a sign-in link that 404s,
	# which reads as the auth service being broken when it is fine.
	#
	# The session cookie needs nothing: cookies are scoped by host and ignore
	# the port, so signing in on any port signs you in on all of them.
	redir /auth /auth/ 308
	handle /auth/* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	# --- everything else is DocuSeal ----------------------------------------
	handle {
		# Signed documents and their attachments. 64MB matches what the other
		# upload-heavy sites here allow.
		request_body {
			max_size 64MB
		}

		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}

		# DocuSeal keeps its own account system behind this gate, the same way
		# Portainer does. For something holding signed documents that is the
		# right way round: the household sign-in says who is in the house, and
		# DocuSeal says who may sign.
		reverse_proxy 192.168.1.86:3002 {
			import appproxy
		}
	}
}

# =============================================================================
#  photos.home.example.net -- Immich
#
#  ITS OWN HOSTNAME, NOT A PATH, AND NOT BEHIND THE HOUSEHOLD SIGN-IN. Both of
#  those are deliberate and both are worth explaining, because they look like
#  exceptions to how everything else here works.
#
#  Not a path: Immich has no base-path setting. Same wall Uptime Kuma and
#  Authentik hit. DuckDNS hands out wildcard subdomains for free, so this costs
#  a line here and nothing else -- no router change, no second certificate to
#  manage, Caddy gets one automatically.
#
#  NOT BEHIND forward_auth, which is the important one. The phone app
#  authenticates with its own token and cannot complete a browser sign-in
#  against our gate; putting the SSO in front would break photo backup on every
#  phone while leaving the website working, which is a confusing way to fail.
#  So Immich does its own authentication -- and it is not a downgrade: separate
#  accounts, real sessions, and each person can only see their own library.
#
#  The practical consequence is that this hostname is reachable from the
#  internet with Immich's own login as the only gate. That is the same
#  arrangement as any hosted photo service, and it is why the accounts on it
#  want real passwords rather than household ones.
# =============================================================================
photos.home.example.net {
	encode zstd gzip

	# Photos and video are large and phones upload them whole. The default cap
	# is a few megabytes, which would reject essentially every video and a good
	# number of raw files -- and it fails as a bare 413 with no explanation on
	# the phone.
	request_body {
		max_size 50GB
	}

	reverse_proxy 192.168.1.86:2283 {
		import appproxy
		# Immich streams uploads and long-polls for job status. The default
		# read timeout cuts a slow upload off mid-file, and the retry then
		# starts again from nothing.
		transport http {
			read_timeout 900s
			write_timeout 900s
		}
	}

	log {
		output file /var/log/caddy/immich.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# =============================================================================
#  peewee.home.example.net -- The First Voice: the Peewee Harris
#  tribute. Added 2026-08-31.
#
#  A STATIC SITE, deliberately. The photographs under /legacy stay behind
#  their password; this is the SHAREABLE face of the same story -- smaller
#  copies of the photos, the family-reviewed stories, and the narration
#  audio the phone line plays. Nothing here can write anything, so there is
#  nothing here to protect beyond bandwidth.
#
#  Not indexed: this is for the family to hand out, not for searches to
#  stumble into. Same posture as /legacy.
# =============================================================================
peewee.home.example.net {
	root * /srv/public/peewee
	# /live is the skip-the-intro door: same page, the JS reads the path
	rewrite /live /index.html
	# The page itself must always revalidate: a phone that caches
	# index.html replays an OLD cinematography against new assets
	# (caught live 2026-09-01). Media stays cacheable.
	@page path / /index.html
	header @page Cache-Control "no-cache"
	# The manifests are the SAME hazard as the page (2026-09-02):
	# stations.json is the dial itself -- who is on it, which tellings
	# exist, and now which paragraph clips a telling is made of. A
	# heuristically cached copy leaves a returning visitor playing a
	# shape of the show that no longer exists. Revalidate; the audio
	# and photographs they point at stay cacheable.
	@manifest path /data/*.json
	header @manifest Cache-Control "no-cache"
	# THE NARRATION IS THE THIRD THING WITH THIS HAZARD, and it was
	# missed twice. A story under people/ is re-rendered whenever its
	# text changes, at the SAME path -- so a browser holding an old copy
	# plays the old telling and there is no way for the listener to know.
	# Jason hit exactly that on 2026-09-19: he asked for a rewritten
	# Pee-Wee story, got the previous one, and reasonably concluded the
	# rewrite had not happened.
	#
	# These files carried NO Cache-Control at all, which is worse than a
	# long one: with nothing set, a browser applies a heuristic -- about
	# a tenth of the file's age -- so the staleness window grows the
	# longer a telling has stood, and is invisible in the config.
	#
	# no-cache is not "do not cache": it is "revalidate first". The
	# browser keeps the bytes and asks; unchanged audio comes back 304
	# with no body. A 600KB story costs one round trip, and a changed
	# one is actually heard.
	@narration path /people/*
	header @narration Cache-Control "no-cache"
	file_server
	header X-Robots-Tag "noindex, nofollow"
	header -Server
	encode gzip
}

# =============================================================================
#  bloodline.home.example.net -- the family, told in the first person.
#
#  NO forward_auth, BY JASON'S WORD (2026-09-03): "no sso for /bloodline just
#  a subdomain". So this block is the only thing between the internet and the
#  page -- which is why it serves STATIC FILES ONLY and reaches no service,
#  no database and no API. There is nothing here to inject into.
#
#  ONE BLOCK, NOT ONE PER PERSON. Jason's note was "each member I add will be
#  a / new caddy proxy"; the URLs he wants are /<name>, and try_files gives
#  him exactly those from a single block. Adding an ancestor is then a line of
#  JSON -- no Caddyfile edit, no validate, no reload, and no chance of the
#  proxy list drifting out of step with the family.
#
#  noindex because a living family's history is not for a search engine, and
#  nobody here consented to being findable.
# =============================================================================
bloodline.home.example.net {
	root * /srv/public/bloodline
	# A PERSON'S PAGE IS A SLUG, AND NOTHING ELSE IS (tightened 2026-09-04
	# after a ZAP baseline scan). The old rule fell back to index.html for
	# ANY path, so /robots.txt, /sitemap.xml and /nonsense all answered
	# 200 with the family tree. Not a leak -- Caddy normalises, and every
	# traversal variant was checked and returns the page rather than a
	# file -- but a site where nothing is ever missing cannot say when
	# something is. Only slug-shaped paths fall back now; the rest 404.
	@slug path_regexp ^/[a-z0-9][a-z0-9-]*/?$
	handle @slug {
		try_files {path} {path}/ {path}.html /index.html
		file_server
	}
	handle {
		file_server
	}
	header X-Robots-Tag "noindex, nofollow, noarchive"
	header -Server
	# A static, script-light page can afford a strict policy, and the
	# cheapest time to set one is before anything is built on top of it.
	header Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "no-referrer"
	# The rest of what ZAP asked for, 2026-09-04. HSTS was the one that
	# mattered: without it a first visit over http is downgradeable.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
	header Cross-Origin-Opener-Policy "same-origin"
	header Cross-Origin-Resource-Policy "same-origin"
	header Cross-Origin-Embedder-Policy "require-corp"
	@page path / /index.html
	header @page Cache-Control "no-cache"
	@data path /data/*.json
	header @data Cache-Control "no-cache"
	encode gzip
}

# =============================================================================
#  studio.home.example.net -- Pee-Wee Studio, the workbench.
#
#  NO forward_auth HERE, BY JASON'S EXPLICIT CHOICE (2026-08-31): he wants the
#  Studio working alongside everything without an SSO wall. This block is the
#  only thing between the internet and a tool that edits the memorial site,
#  and it deliberately adds none. If that choice is ever revisited, a one-line
#  basic_auth here is the smallest wall that is not SSO.
# =============================================================================
# =============================================================================
#  Pee-Wee Studio -- the tool that EDITS the tribute. Gated, as of 2026-09-15.
#
#  It was a bare reverse_proxy: no forward_auth, 200 to anyone on the
#  internet. Every other gated surface in this file answers 303 to an
#  unauthenticated probe; this one answered with the app. Streamlit has no
#  authentication of its own, so nothing behind it was checking either.
#
#  WHAT THAT REACHED. The container mounts the live tribute READ-WRITE:
#      web/public/peewee -> /site   rw
#      peewee-tools      -> /tools  rw
#  So the console that manages the memorial to Edward "Pee-Wee" Harris was
#  editable by anyone who found the hostname. noindex keeps it out of search
#  results; it is not access control, and a subdomain is not a secret --
#  every certificate issued for it is published in the CT logs.
#
#  Found by asking every app on /home for its status code and noticing this
#  was the only gated-looking one that returned 200.
# =============================================================================
studio.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	# The sign-in callback must NOT be behind the gate it serves, or the
	# redirect loops -- same shape as every other subdomain here.
	handle /__sso* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	handle {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
			header_up X-Forwarded-Host {host}
		}
		reverse_proxy peewee-studio:8501
	}
}

# =============================================================================
#  docuseal.home.example.net -- the same service that lived on
#  example.org:9444, moved to a subdomain on plain 443 so the
#  router forward for :9444 can close (2026-08-31: the router goes down to
#  80 and 443 and nothing else). The old port block remains above but the
#  router no longer forwards its port, so it serves only the LAN.
# =============================================================================
#  RETIRED 2026-09-06 -- docuseal.home.example.net
#
#  Jason: "I don't need the PDF signing since I have the one thats wired into
#  career." Nothing was ever signed with it: the docuseal database had no
#  tables at all. The only traffic in its final week was five foreign IP
#  addresses hitting the dashboard -- 8.211.174.175, 123.160.223.75,
#  47.251.90.48, 84.239.14.183, 154.47.20.230 -- so withdrawing the hostname
#  closes a door that was serving scanners and nobody else.
#
#  Containers stopped, not removed. The block below is commented rather than
#  cut so that if it ever comes back, the reasoning about how it was wired
#  is still here rather than needing to be worked out again.
# =============================================================================
## =============================================================================
# docuseal.home.example.net {
