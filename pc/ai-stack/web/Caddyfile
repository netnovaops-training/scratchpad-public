	# --- NUC homelab, second batch, same 2026-08-27 -------------------------
	# Gitea, Linkding, IT-Tools, Stirling-PDF. Same reasoning as /status and
	# /logs above -- no Caddy/SSO on the NUC itself, this stays the one
	# front door. Stirling-PDF's own built-in login is disabled
	# (SECURITY_ENABLELOGIN=false in share/nuc-homelab/docker-compose.yml)
	# so forward_auth here is its only gate, same as every other app.
	#
	# NOTE: SearXNG (/search) and Linkding (/links) were both here too --
	# both removed 2026-08-28, Jason's call. SearXNG wanted to search HIS
	# OWN content (recipes/KB/photos), and SearXNG only federates external
	# search engines out of the box (see share/nuc-homelab/README.md's own
	# note on this, flagged as real scoping work before this deploy even
	# started) -- container removed entirely, not just unwired. Linkding
	# removed on request, no reason given beyond "let's remove this
	# container." Both containers and their compose entries are gone, not
	# just this Caddyfile block -- see share/nuc-homelab/docker-compose.yml.
	# --- git clone / push over HTTPS -----------------------------------------
	# THIS MUST COME BEFORE THE /git BLOCK BELOW, and is deliberately NOT
	# behind forward_auth.
	#
	# The SSO gate answers an unauthenticated request with a 303 to an HTML
	# sign-in form. A browser follows that happily. A GIT CLIENT CANNOT --
	# it has no way to fill in a login page, so `git clone` and `git push`
	# over HTTPS failed for everyone, always, with a redirect it could not
	# interpret. Measured 2026-08-28: info/refs returned 303 to /auth/.
	# That is why the repository was only ever pushable from the NUC itself,
	# straight at http://localhost:3000 with Caddy out of the picture.
	#
	# THESE THREE PATHS ARE STILL AUTHENTICATED -- by Gitea, which is the
	# thing that actually knows who owns the repository. It answers with a
	# 401 and Basic auth, which git DOES understand, and prompts for a
	# username and password (or an access token). A private repo stays
	# private; this only stops Caddy from intercepting the handshake with a
	# login form meant for humans.
	#
	# The regex is deliberately narrow: only Gitea's three smart-HTTP
	# endpoints, only under a *.git path. Everything else about /git -- the
	# web UI, settings, the admin panel -- stays behind the household SSO.
	# (The @git_smart_http block that used to sit here has moved INSIDE the
	# /git handle below. It could never run from out here -- see the note in
	# there. Left as a pointer so the next person looking for it finds it.)

	handle /git/* {
		route {
			uri strip_prefix /git

			# --- git push/fetch, BEFORE forward_auth ----------------------
			# This used to be its own `handle @git_smart_http` block fifty
			# lines above, and it never ran. Caddy would not order it ahead
			# of this block whether it was written as handle_path or handle
			# -- `caddy adapt` put /git/* first both ways -- so pushes 303'd
			# to the sign-in page and git followed the redirect into HTML.
			#
			# `route` DOES preserve the order written inside it. So the
			# bypass lives here now, as the first thing in the route, which
			# is the only placement that actually guarantees it runs first.
			#
			# Paths are matched AFTER strip_prefix, hence no /git below.
			#
			# THE THREE header_up LINES ARE WHAT KEEP THIS FROM BEING A BACK
			# DOOR. Gitea trusts X-Webauth-User as proof of identity. This is
			# the one place under /git where forward_auth does not run, so a
			# header arriving here is one a CLIENT chose to send -- without
			# these,  git -c http.extraHeader="X-Webauth-User: Jason" push
			# would be a push as Jason with no credential at all. Stripping
			# them means the only thing that can authenticate is Gitea's own
			# Basic auth, which is what was always doing it.
			@smart_http path_regexp ^/[^/]+/[^/]+\.git/(info/refs|git-upload-pack|git-receive-pack)$
			reverse_proxy @smart_http 192.168.1.86:3000 {
				import appproxy
				header_up -X-Webauth-User
				header_up -X-Webauth-Email
				header_up -X-Webauth-Fullname
			}

			forward_auth https://192.168.1.86 {
				import nuc_gate
				uri /verify
				copy_headers X-Auth-Email
				# The original path, not the stripped one -- see /status for the
				# full account of what breaks without this.
				header_up X-Forwarded-Uri {http.request.orig_uri}
			}

			# --- the household email -> Gitea's own username -----------------
			# Added 2026-09-04, to end the second sign-in at /git.
			#
			# WHY A TRANSLATION TABLE AND NOT JUST THE EMAIL. Gitea's reverse
			# proxy auth looks the person up by USERNAME (GetUserByName), not by
			# email -- ENABLE_REVERSE_PROXY_EMAIL only changes which address an
			# AUTO-REGISTERED account is given, it does not make the lookup
			# search on email. Gitea's usernames here are "Jason" and "Robin"; the
			# gate's identity is an email address. Something has to bridge the
			# two, and Caddy is the only place that already knows both.
			#
			# THE DEFAULT IS DELIBERATELY EMPTY, and that is the safety property.
			# Gitea trims this header and treats an empty value as "no header at
			# all", so somebody signed into the house who has no Gitea account
			# meets Gitea's own login page rather than being handed an account
			# that is not theirs. Auto-registration is OFF on Gitea's side too,
			# so an unmapped address cannot quietly grow a second, empty account
			# either.
			#
			# WHEN SOMEBODY NEW NEEDS /git: create the Gitea account first, then
			# add the line here. Two steps on purpose -- the one-step
			# alternative is auto-registration, which is precisely how Jason's
			# repositories would end up beside a duplicate account.
			map {http.request.header.X-Auth-Email} {gitea_user} {
				"user@example.com"       "Jason"
				"user@example.com" "Robin"
				default               ""
			}

			reverse_proxy 192.168.1.86:3000 {
				import appproxy
				# SET, never forwarded. Whatever a browser sent under this name is
				# replaced by the value Caddy just computed -- same reasoning as
				# X-Forwarded-User on /special.
				header_up X-Webauth-User {gitea_user}
				header_up -X-Webauth-Email
				header_up -X-Webauth-Fullname
			}
		}
	}

	# Portainer -- the Docker UI, added 2026-08-28. Runs HERE on the main PC
	# (ai-stack/docker-compose.web.yml), not the NUC, but manages both boxes
	# via the NUC's portainer-agent. `handle_path` (strips the prefix) paired
	# with the container's own --base-url=/portainer, same two-halves shape
	# as Gitea's ROOT_URL above.
	#
	# Behind forward_auth like everything else AND keeps its own login on
	# top -- the one app here holding the Docker socket, which is
	# root-equivalent. See the service's comment in docker-compose.web.yml.
	# Portainer's setup-timeout page link is emitted ROOT-ABSOLUTE
	# (/timeout.html), so under the /portainer prefix it lands here at the
	# domain root rather than inside the app. --base-url covers its assets
	# and API but not this one link.
	#
	# THIS WAS A `redir /timeout.html /portainer/ 302` UNTIL 2026-08-28,
	# AND THAT WAS AN INFINITE LOOP. The note here used to claim the image
	# had no real timeout.html (a 404 at Portainer's own root). That was
	# wrong -- it serves a real 200. So once Portainer entered the
	# timed-out state, its root 307'd to /timeout.html, the redirect sent
	# the browser back to /portainer/, and round it went forever. Signing
	# in appeared to do nothing, which is exactly how it was reported.
	#
	# Proxying instead of redirecting shows Portainer's actual message and
	# cannot loop, because this path now terminates at a real page.
	#
	# This does put a generic path in the main domain's root namespace,
	# which is the same objection that killed the Kasm plan -- the
	# difference is scale: one static page, versus proxying a live
	# websocket endpoint for an app's entire runtime.
	handle /timeout.html {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			# THE ORIGINAL PATH, NOT THE STRIPPED ONE.
			#
			# handle_path removes the prefix before this runs, so Caddy's
			# own X-Forwarded-Uri arrived at the auth service as "/" for
			# every app in a handle_path block. Two things broke, and only
			# the harmless one was visible:
			#
			#  1. Signing in dumped you at the site root instead of the
			#     page you asked for -- /auth/?next=/ rather than
			#     ?next=/git/.
			#  2. MUCH WORSE: app_for_uri() decides per-app permissions by
			#     matching that path. Given "/" it matched nothing and
			#     returned None, which means "being on the sign-in list is
			#     the only gate" -- so the per-app toggles on /admin/people
			#     did nothing at all for /git, /portainer, /status, /tools
			#     and /pdf. Anyone who could sign in could reach Portainer,
			#     which holds the Docker socket and is root-equivalent.
			#
			# Proven by the one block that does NOT strip: /logs uses
			# `handle` and correctly produced ?next=/logs/ while every
			# handle_path app produced ?next=/ (measured 2026-08-28).
			#
			# orig_uri is the path as the browser sent it, before any
			# rewrite -- which is what both the redirect and the permission
			# check have always meant to use.
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy portainer:9000 {
			import appproxy
		}
	}

	redir /portainer /portainer/ 308
	handle_path /portainer/* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			# THE ORIGINAL PATH, NOT THE STRIPPED ONE.
			#
			# handle_path removes the prefix before this runs, so Caddy's
			# own X-Forwarded-Uri arrived at the auth service as "/" for
			# every app in a handle_path block. Two things broke, and only
			# the harmless one was visible:
			#
			#  1. Signing in dumped you at the site root instead of the
			#     page you asked for -- /auth/?next=/ rather than
			#     ?next=/git/.
			#  2. MUCH WORSE: app_for_uri() decides per-app permissions by
			#     matching that path. Given "/" it matched nothing and
			#     returned None, which means "being on the sign-in list is
			#     the only gate" -- so the per-app toggles on /admin/people
			#     did nothing at all for /git, /portainer, /status, /tools
			#     and /pdf. Anyone who could sign in could reach Portainer,
			#     which holds the Docker socket and is root-equivalent.
			#
			# Proven by the one block that does NOT strip: /logs uses
			# `handle` and correctly produced ?next=/logs/ while every
			# handle_path app produced ?next=/ (measured 2026-08-28).
			#
			# orig_uri is the path as the browser sent it, before any
			# rewrite -- which is what both the redirect and the permission
			# check have always meant to use.
			header_up X-Forwarded-Uri {http.request.orig_uri}
