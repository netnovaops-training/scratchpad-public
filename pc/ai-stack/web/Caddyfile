# ---------------------------------------------------------------------------
#  n8n on the Pi -- the mail gatekeeper.  192.168.1.69:5678
#
#  TWO PATHS ARE DELIBERATELY UNGATED, and each one has to be.
#
#  /rest/oauth2-credential/callback  is where GOOGLE lands after you
#  authorise the Gmail account. Google's browser redirect carries no
#  household SSO cookie, so behind forward_auth it is bounced to the login
#  page and the authorisation silently fails with a callback error that
#  says nothing about why. It is a fixed path, it accepts only a one-time
#  code that n8n itself issued moments earlier, and the code is useless to
#  anyone who cannot also decrypt n8n's credential store.
#
#  /webhook*  is the entire point of a webhook: an outside service calls
#  it. Gating it would mean nothing could ever trigger a workflow. The
#  protection is that each path ends in an unguessable UUID n8n generates.
#
#  Everything else -- the editor, the credential store, the execution
#  history -- is behind the household gate AND n8n's own owner login.
# ---------------------------------------------------------------------------
n8n.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	handle /__sso* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	# Ungated, for the reasons above. Listed before the catch-all so they
	# win -- Caddy matches handle blocks in order of specificity, but
	# writing them first keeps the intent readable.
	handle /rest/oauth2-credential/callback* {
		reverse_proxy 192.168.1.69:5678 {
			import appproxy
		}
	}
	handle /webhook* {
		reverse_proxy 192.168.1.69:5678 {
			import appproxy
		}
	}

	handle {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
			header_up X-Forwarded-Host {host}
		}
		# Workflows move attachments -- a scanned receipt, a book.
		request_body {
			max_size 64MB
		}
		reverse_proxy 192.168.1.69:5678 {
			import appproxy
		}
	}
}

# ---------------------------------------------------------------------------
#  watch. -- the outside-in watchdog on the Pi.  192.168.1.69:3002
#
#  A SECOND Uptime Kuma, not a move. The NUC keeps its own at :3001.
#
#  WHY THE DUPLICATE IS THE WHOLE POINT. On 2026-09-10 haproxy-relay exited
#  during a reboot and every public site was unreachable for hours while
#  every container on the PC reported healthy. The monitor that should have
#  caught it was on the NUC -- inside the outage. This one is on neither
#  machine it watches.
#
#  AND NOTE THE LIMIT OF THIS BLOCK. Reaching this page goes through the
#  relay and this Caddy, so the exact outage it exists to catch also hides
#  its own dashboard. That is unavoidable and it is fine, because the
#  dashboard is not the alerting mechanism -- the push notification is.
#  Configure a notification channel in it or it is decoration. It is also
#  always reachable on the LAN at http://192.168.1.69:3002 with nothing in
#  the way, which is where to look when everything else is down.
# ---------------------------------------------------------------------------
watch.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	handle /__sso* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	handle {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
			header_up X-Forwarded-Host {host}
		}
		reverse_proxy 192.168.1.69:3002 {
			import appproxy
		}
	}
}

# ---------------------------------------------------------------------------
#  files. -- the front door for putting things ON the shelves.
#            192.168.1.86:8099 (FileBrowser)
#
#  Jason, 2026-09-11: "i have mango for casey its in cbz format I want to
#  upload this any more how do I". scp is not an answer for Casey.
#
#  It writes straight into the same trees Kavita reads -- /home/user/manga
#  and /home/user/documents -- so an uploaded .cbz is a file Kavita finds
#  on its next scan. No copy step and no second opinion about where a book
#  lives.
#
#  request_header -X-Auth-Email IS THE SECURITY CONTROL HERE, and it is
#  worth saying why it is spelled out rather than left to the shared
#  snippet. FileBrowser is configured with --auth.method=proxy, so it
#  believes whoever X-Auth-Email says you are. The (appproxy) snippet
#  strips nine forgeable identity headers -- X-Real-IP, True-Client-IP and
#  friends -- but it does NOT strip X-Auth-Email, because until now nothing
#  downstream read it as an identity it would act on without also checking
#  a session.
#
#  Deleting it on the way IN, before forward_auth runs, means the only
#  X-Auth-Email that can reach the app is the one the auth service issued
#  a moment ago. A household member with a valid session cannot relabel
#  themselves as somebody else on the way past. That is the specific attack:
#  not an outsider getting in, but Casey arriving as Jason and seeing the tax
#  returns.
# ---------------------------------------------------------------------------
files.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	# Runs before forward_auth in Caddy's directive order. See above.
	request_header -X-Auth-Email

	handle /__sso* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	handle {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
			header_up X-Forwarded-Host {host}
		}
		# A manga volume is 50-200MB and a scanned book can be larger.
		request_body {
			max_size 2GB
		}
		reverse_proxy 192.168.1.86:8099 {
			import appproxy
		}
	}
}

# ---------------------------------------------------------------------------
#  push. -- ntfy on the Pi.  192.168.1.69:8093
#
#  THE ONLY SITE HERE WITHOUT forward_auth, AND THAT IS A CHOICE, NOT AN
#  OVERSIGHT. (dj. is the other, for a different reason -- a public stream
#  is meant to be public.)
#
#  The ntfy phone app holds a long-lived subscription and authenticates
#  with a bearer token. It has no browser, no cookie jar, and no way to
#  complete an SSO redirect. Put the household gate in front of this and
#  notifications simply stop arriving, with no error anywhere that says
#  why -- the worst possible failure mode for the thing whose entire job
#  is telling you something has failed.
#
#  WHAT PROTECTS IT INSTEAD is ntfy's own auth, set to
#  auth-default-access: deny-all in ntfy-server.yml. Verified before this
#  block was written: an anonymous publish and an anonymous subscribe both
#  return 403. Two accounts exist -- an admin for the phone, and a
#  WRITE-ONLY machine account for Uptime Kuma that can post to one topic
#  and read nothing, so a leak of the credential stored in Kuma's database
#  means somebody can send a fake alert, not read every alert this house
#  has generated.
#
#  WHY IT IS PUBLIC AT ALL, given everything else is gated: because a
#  notifier that only works on the house wifi is useless. The outage it
#  reports is most likely to be found out about while away from home.
# ---------------------------------------------------------------------------
push.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	reverse_proxy 192.168.1.69:8093 {
		import appproxy
		# ntfy holds subscriptions open indefinitely -- that is how push
		# works. Without this, Caddy's default read timeout severs the
		# connection and the app reconnects in a loop, burning battery
		# and missing messages in the gaps.
		transport http {
			read_timeout 24h
		}
	}
}

# ---------------------------------------------------------------------------
#  media. -- Jellyfin on the NUC.  192.168.1.86:8096
#
#  The PRIVATE library. Plex on the NAS keeps the household one.
#
#  NO forward_auth, for the third time on this stack and the same reason as
#  ntfy and dj.: the Jellyfin apps speak Jellyfin's own token API, have no
#  browser, and cannot complete an SSO redirect. Gate this and the web page
#  works while every phone and TV silently fails to sign in.
#
#  The SSO is INSIDE Jellyfin instead, via its OIDC plugin pointed at the
#  household provider -- same credentials, and the apps keep working because
#  to them it is ordinary Jellyfin auth. The OIDC client is registered as
#  `jellyfin` with redirect
#      https://media.home.example.net/sso/OID/redirect/household
#  and the provider in the plugin MUST be named exactly `household`, because
#  redirect URIs are matched here as literal strings and never as patterns.
#
#  THE HOSTNAME IS DELIBERATELY NEUTRAL. `media.` rather than anything
#  descriptive: the DNS name is the one part of this that is visible to
#  anyone who can see a certificate log, and Let's Encrypt publishes every
#  name it issues to public CT logs. There is no way to have a public
#  hostname and keep the hostname private, so the hostname says nothing.
#
#  STREAMING NEEDS A LONG TIMEOUT. A two-hour film is one HTTP response.
#  Caddy's default read timeout would cut it, and the client would show it
#  as the video stopping partway with no error.
# ---------------------------------------------------------------------------
media.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	reverse_proxy 192.168.1.86:8096 {
		import appproxy
		transport http {
			read_timeout 6h
		}
		flush_interval -1
	}
}

# ---------------------------------------------------------------------------
#  grab. -- MeTube on the Pi, inside the VPN tunnel.  192.168.1.69:8081
#
#  Jason and Sachin paste a URL, it downloads through Proton, and it lands
#  in either the general or the private library.
#
#  GATED, unlike media./push./dj. -- and it can be, because this one is
#  only ever used from a browser. There is no app holding a bearer token to
#  break, so the household gate is free to do its job properly here.
#
#  AND THE GATE IS DOING MORE THAN "ARE YOU LOGGED IN". `grab` is registered
#  in rust/common/src/people.rs as an EXPLICIT_ONLY app, so
#  Person::level_for() returns None for anyone without a named grant and
#  /verify answers 403 -- including accounts flagged apps_unrestricted,
#  which inherit every other app automatically. That inversion is the whole
#  point: this writes into the private library, so "everyone by default"
#  is the wrong default, and adding the app to one list is cheaper and more
#  durable than remembering to narrow each account.
#
#  MeTube itself has NO login. That is fine and deliberate -- it is only
#  reachable through this block, and it binds to the Pi's LAN address
#  otherwise. If it were ever published without forward_auth, anyone could
#  queue downloads into the house.
#
#  WEBSOCKET: the progress bar is a websocket, which Caddy upgrades
#  automatically, but a long download holds it open for the duration --
#  hence the read timeout. Without it the bar freezes partway while the
#  download carries on invisibly, which looks exactly like a hang.
# ---------------------------------------------------------------------------
# =========================================================================
#  go.* -- the link shortener (Shlink on the NUC, :8097)
#
#  THIS ONE IS NOT GATED, AND THAT IS THE ENTIRE POINT. A short link is
#  something Jason sends to somebody who does not have an account yet --
#  putting the household sign-in in front of it would mean a friend has to
#  authenticate before they can reach the invite that would have given them
#  an identity. The link IS the credential: single use, expiring, and
#  revocable from the admin side without touching whatever it points at.
#
#  WHAT IS STILL PROTECTED. /rest/* is Shlink's REST API and it refuses
#  every request without a valid X-Api-Key header, so it carries its own
#  auth and must stay reachable for Hermes and the admin panel to mint
#  links programmatically. Wrapping it in forward_auth would break exactly
#  those callers while adding nothing a stolen API key could not already
#  do. Rate limiting, not sign-in, is the right control here.
# =========================================================================
go.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	reverse_proxy 192.168.1.86:8097 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
	}
}

grab.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	handle /__sso* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	handle {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email X-Auth-Level
			header_up X-Forwarded-Uri {http.request.orig_uri}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Method {method}
		}
		# Direct video uploads as well as URLs.
		request_body {
			max_size 16GB
		}
		reverse_proxy 192.168.1.69:8081 {
			import appproxy
			transport http {
				read_timeout 12h
			}
		}
	}
}

# ---------------------------------------------------------------------------
#  drop. -- the upload page.  192.168.1.86:8100 (the intake service)
#
#  Jason, 2026-09-11: "either of us need a book we add it to our collection
#  ... to down load to paperless and be auto tagged based on who is logined
#  in".
#
#  THE PAGE HAS NO "WHO IS THIS FOR" CONTROL. forward_auth has already
#  established that, and copy_headers hands the verified address to the app
#  as X-Auth-Email. Asking a second time would be worse than redundant: a
#  dropdown can be left on its last value, and the failure that produces is
#  a medical record filed under the wrong person.
#
#  request_header -X-Auth-Email IS LOad-BEARING, same as on files. The app
#  trusts that header completely -- it is the only thing deciding whose file
#  this is -- so an inbound one has to be destroyed before forward_auth sets
#  the real one. Without it a household member with a valid session could
#  relabel themselves on the way past and file into somebody else's shelf.
#  The shared (appproxy) snippet strips nine forgeable identity headers but
#  NOT this one.
#
#  The intake container binds to 192.168.1.86 only, so this block is the
#  sole route to it.
# ---------------------------------------------------------------------------
drop.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	request_header -X-Auth-Email

	handle /__sso* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	handle {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email X-Auth-Level
			header_up X-Forwarded-Uri {http.request.orig_uri}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Method {method}
		}
		# A film is the largest thing that goes through here.
		request_body {
			max_size 16GB
		}
		reverse_proxy 192.168.1.86:8100 {
			import appproxy
			transport http {
				read_timeout 6h
			}
		}
	}
}

# =============================================================================
#  nights.home.example.net -- the nights played, and the photographs
#
#  PUBLIC TO READ, SSO TO ADD. The point of the page is showing it to
#  somebody -- a recruiter reading the AV half of the CV, or whoever is
#  thinking about booking him -- so / and the images have no gate. Everything
#  that WRITES, and /manage which is the same page with the upload panel
#  showing, goes through forward_auth first.
#
#  NOT dj.home.example.net: that hostname is the live Owncast stream
#  and has been since 2026-09-10. Caddy caught the collision as an "ambiguous
#  site definition" and refused to load rather than silently letting one block
#  win, which is the good outcome -- the stream never went down.
#
#  ITS OWN HOSTNAME RATHER THAN A PATH ON THE MAIN SITE, and that is not a
#  preference. The page asks for /api/library and /photo/... at the root; put
#  it behind a stripped path prefix and those absolute URLs land on the main
#  site instead, which 404s in a way that looks like the app is broken.
#
#  THE SERVICE PUBLISHES NO PORT. Reachable only from this proxy on the
#  compose network, which is the whole reason it may trust X-Auth-Email.
# =============================================================================
nights.home.example.net {
	import common

	# Sign-in on this hostname too: forward_auth's redirect is relative, so
	# an unauthenticated arrival is sent to /auth/ HERE.
	redir /auth /auth/ 308
	handle /auth/* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	# The gated half: the manage view and every write.
	@guarded path /manage /api/upload /api/gig /api/gig-delete /api/assign /api/move /api/delete
	handle @guarded {
		# A ceiling, not a permit: Caddy has no default body limit, so
		# without this one bad request can stream unbounded bytes into a
		# service whose whole job is writing them to disk. 64MB clears a
		# HEIC from any phone with room to spare.
		request_body {
			max_size 64MB
		}
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy dj:8026 {
			import appproxy
		}
	}

	# Everything else, public. The page must revalidate -- a cached copy
	# shows an old running order -- while the photographs are immutable.
	handle {
		@page path / /static/*
		header @page Cache-Control "no-cache"
		reverse_proxy dj:8026 {
			import appproxy
		}
	}
}

# =============================================================================
#  wiki.garden.example.net -- Robin's garden encyclopedia (Wiki.js)
#
#  NO forward_auth, AND THAT IS DELIBERATE. Jason, 2026-09-24: "Juns and
#  mine manage the wiki but anyone can read it." Wiki.js has its own users
#  and groups and does exactly that natively -- so the permission model is
#  its job. Putting the household sign-in in front would lock out the
#  readers it is FOR, and approximating "public read, two editors" at the
#  proxy would be a worse version of something the app already does.
#
#  THE BARE garden.example.net POINTS SOMEWHERE ELSE -- 108.4.155.134
#  on 2026-09-24, not this house. The wildcard subdomains resolve here
#  correctly, which is why the wiki uses one. Worth fixing separately.
#
#  Wiki.js is a single-page app with a GraphQL API and websockets for live
#  editing; reverse_proxy upgrades those itself, and the long timeouts are
#  for an editor left open.
# =============================================================================
wiki.garden.example.net {
	import common

	# RETIRED 2026-10-25: Robin's Garden is not served from here.
	respond "Robin's Garden moved." 410
}

# =============================================================================
#  test.garden.example.net -- the Rust rewrite, under test
#
#  THE STAGING DOOR FOR ROBIN'S SITE. Jason's workflow: branch the change, run
#  it here, and only promote to garden.example.org once it behaves. The
#  live PHP site is untouched by anything on this hostname -- different
#  container, different port, same database READ-ONLY paths for now.
#
#  PUBLIC, BECAUSE THE REAL SITE IS PUBLIC. Gating this behind the household
#  sign-in would test something the live site does not do, and the first
#  thing to get wrong in a rewrite is what an anonymous visitor sees.
#
#  BUT NEVER INDEXED. A staging copy of a real site in a search engine
#  outranks the original often enough to be a known hazard, and the pages
#  here are by definition half-finished. X-Robots-Tag is sent on every
#  response rather than relying on a robots.txt the crawler may not fetch.
# =============================================================================
test.garden.example.net {
	import common

	header X-Robots-Tag "noindex, nofollow, noarchive"

	# RETIRED 2026-10-25: Robin's Garden is not served from here.
	respond "Robin's Garden moved." 410
}

# =============================================================================
#  wiki.home.example.net -- Jason's own wiki (Wiki.js), PRIVATE
#
#  A SECOND INSTANCE, NOT A FOLDER IN ROBIN'S, and the reason is the one above:
#  Robin's wiki is public to read on purpose. A private tree inside a public
#  wiki is correct only for as long as its page rules stay correct, and the
#  failure mode is publishing somebody's notes. Two instances cannot make
#  that mistake.
#
#  forward_auth HERE, unlike Robin's. There is no public readership to lock
#  out -- this one is his. The household sign-in gates the whole hostname,
#  and Wiki.js's own accounts sit behind it as a second layer rather than
#  the only one.
#
#  /auth/ MUST EXIST ON THIS HOSTNAME TOO. forward_auth's redirect is
#  relative, so somebody sent to sign in has to find the door here rather
#  than on example.org.
#
#  Separate database (jason_wiki) on the same MariaDB, its own content
#  volume, port 8027 on the NUC, bound to the LAN address only.
# =============================================================================
wiki.home.example.net {
	import common

	redir /auth /auth/ 308
	handle /auth/* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	# THE SIGN-IN CALLBACK MUST NOT BE BEHIND THE GATE IT SERVES.
	#
	# Left out when this hostname was added, and the result was the loop
	# Jason hit: the bridge sends the browser to /__sso?code=...&next=...,
	# which fell through to Wiki.js. Wiki.js has no such route, so the code
	# was never consumed, the gate bounced the browser back to sign in, and
	# each pass wrapped the previous URL inside a new `next` -- the link
	# grew a nested layer every time until Chrome gave up.
	#
	# Every other bridged subdomain in this file carries this block for
	# exactly this reason, and says so.
	handle /__sso* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	handle {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy 192.168.1.86:8027 {
			import appproxy
			transport http {
				read_timeout 4h
				write_timeout 4h
			}
		}
	}
}

# =============================================================================
#  collage.home.example.net -- the wall above the fridge
#
#  PUBLIC TO READ, SSO TO REARRANGE. The gallery is a wall of family
#  photographs and there is nobody to hide it from, so / and the images have
#  no gate. Everything that WRITES -- and /manage, which is the same page with
#  the arrows showing -- goes through forward_auth first, and the verified
#  address is passed on in X-Auth-Email.
#
#  THE SERVICE PUBLISHES NO PORT. It is reachable only from this proxy on the
#  compose network, which is the whole reason it may trust that header. Same
#  pattern as Gitea and Paperless here, and the same rule: do not publish one.
#
#  A NEW HOSTNAME COSTS NOTHING. Caddy picks sites by SNI and the router
#  already forwards 80/443 through the NUC relay to this Caddy regardless of
#  hostname, so this needs no new port and gets its own certificate.
# =============================================================================
collage.home.example.net {
	import common

	# Sign-in, on this hostname too: forward_auth's redirect is relative, so
	# an unauthenticated arrival is sent to /auth/ HERE. Without this block
	# that path would fall through to the collage app and 404 -- a sign-in
	# link that 404s, which reads as the gate being broken when it is fine.
	redir /auth /auth/ 308
	handle /auth/* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	# The gated half: the manage view and every write.
	@guarded path /manage /api/move /api/upload /api/delete
	handle @guarded {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy collage:8024 {
			import appproxy
		}
	}

	# Everything else, public. The page must revalidate -- a cached copy
	# replays an old wall against new photographs -- while the photographs
	# themselves are immutable and cache hard.
	handle {
		@page path / /static/*
		header @page Cache-Control "no-cache"
		reverse_proxy collage:8024 {
			import appproxy
		}
	}
}
