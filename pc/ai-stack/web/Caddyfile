			import appproxy
		}
	}

	# --- /audiobookshelf: the player for narrate.py's output ------------------
	# /listen redirects here. Jason asked for /listen and that is the name
	# worth keeping, but this app cannot live under it: "/audiobookshelf" is
	# compiled into its client HTML, so any other prefix serves a page whose
	# assets all 404. A redirect keeps the short name honest; a rewrite would
	# have kept it working until the next release.
	redir /listen /audiobookshelf/ 308
	redir /listen/* /audiobookshelf{uri} 308

	# Jason, 2026-09-10: "have a reader and an audio book that can use TTS of
	# voice models I have to read aloud documents too".
	#
	# handle, not handle_path: the prefix is what the app expects to see.
	#
	# By service name, not 127.0.0.1: Caddy is a container, so loopback is
	# its own, not the host's. Both live in docker-compose.web.yml, so the
	# compose network resolves this.
	# TWO PATHS UNGATED, and both have to be. Added 2026-09-11 when
	# Audiobookshelf became the last app to get SSO.
	#
	# /audiobookshelf/auth/*  is ABS's OWN OpenID flow. Gating it is
	# circular -- you would have to pass the household login in order to
	# reach the household login -- and the callback arrives from the
	# provider carrying a one-time code, not a session cookie, so it is
	# bounced to a sign-in page and the whole exchange dies at the last
	# step.
	#
	# /audiobookshelf/api/*  is what the PHONE APP speaks. It holds a
	# bearer token and has no browser, so a redirect to an HTML login is
	# not something it can answer; SSO would appear to work on the web and
	# fail silently on every phone. Confirmed by hand: a request carrying a
	# perfectly valid API key got 303 to /auth/ instead of JSON.
	#
	# What protects them is ABS's own auth, which is a real token system,
	# and it is now backed by the household provider -- so the credentials
	# are the same ones the gate would have asked for. Same trade already
	# made for ntfy, Jellyfin and n8n's OAuth callback, for the same
	# reason each time: token clients cannot complete a browser redirect.
	handle /audiobookshelf/auth* {
		reverse_proxy audiobookshelf:80 {
			import appproxy
		}
	}
	handle /audiobookshelf/api* {
		reverse_proxy audiobookshelf:80 {
			import appproxy
		}
	}

	handle /audiobookshelf* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy audiobookshelf:80 {
			import appproxy
		}
	}

	# --- /s/: share links. THE ONLY ROUTE ON THIS SITE WITH NO GATE -----------
	# Jason, 2026-09-07: "allows somebody to view a recipe on my site without
	# them having to get a login just to view that".
	#
	# NO forward_auth HERE, deliberately and uniquely. The token in the URL is
	# the authorisation, and it was minted from behind the gate by somebody who
	# could already open that one document. What keeps this narrow is on the
	# other side: a token names exactly one record, is checked for expiry and
	# revocation on every single request, and is stored only as a hash -- so
	# reading the database gives you a list of what was shared and the ability
	# to open none of it.
	#
	# NOT handle_path. The app's own route is /s/{token}, so the prefix has to
	# survive.
	handle /s/* {
		reverse_proxy 192.168.1.86:8087 {
			import appproxy
		}
	}

