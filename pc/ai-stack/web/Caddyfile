	# DocuSeal is NOT proxied here, deliberately (2026-08-28).
	#
	# It cannot be served from a path: it ignores RAILS_RELATIVE_URL_ROOT
	# (tested -- /pdf-sign/ returned its own 404) and stripping the prefix
	# breaks it the other way, because its assets are root-absolute. Same shape
	# as the /websockify problem that killed the Kasm plan.
	#
	# Jason's call: link straight to it on the LAN instead of giving it a
	# hostname. The card on /jason points at http://192.168.1.86:3002. That
	# means it works at home and nowhere else, which for a document-signing
	# tool is a reasonable place to draw the line -- and it is the honest
	# alternative to a proxy arrangement that does not work.

	redir /tools /tools/ 308
	handle_path /tools/* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			# THE ORIGINAL PATH, NOT THE STRIPPED ONE.
			#
			# handle_path removes the prefix before this runs, so Caddy's
			# own X-Forwarded-Uri arrived at the auth service as "/" for
			# every app in a handle_path block. Two things broke, and only
			# the harmless one was visible:
			#
			#  1. Signing in dumped you at the site root instead of the
			#     page you asked for -- /auth/?next=/ rather than
			#     ?next=/git/.
			#  2. MUCH WORSE: app_for_uri() decides per-app permissions by
			#     matching that path. Given "/" it matched nothing and
			#     returned None, which means "being on the sign-in list is
			#     the only gate" -- so the per-app toggles on /admin/people
			#     did nothing at all for /git, /portainer, /status, /tools
			#     and /pdf. Anyone who could sign in could reach Portainer,
			#     which holds the Docker socket and is root-equivalent.
			#
			# Proven by the one block that does NOT strip: /logs uses
			# `handle` and correctly produced ?next=/logs/ while every
			# handle_path app produced ?next=/ (measured 2026-08-28).
			#
			# orig_uri is the path as the browser sent it, before any
			# rewrite -- which is what both the redirect and the permission
			# check have always meant to use.
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy 192.168.1.86:8082 {
			import appproxy
		}
	}

	# --- Spring's sign-in link, which it writes at the wrong depth -------
	#
	# Jason, 2026-09-06: "/oauth2/authorization/household still isn't
	# working." It 404d, and it was never going to do anything else.
	#
	# /oauth2/authorization/<registration> is not an IdP endpoint -- no
	# identity provider serves it. It is Spring Security's login-INITIATION
	# path, served by the app doing the signing in. That app is Stirling
	# PDF, which is Spring Boot and lives at /pdf/.
	#
	# Stirling knows its public base URL well enough to register the
	# callback correctly (OIDC_CLIENTS has /pdf/login/oauth2/code/household)
	# but writes the link on its own login page as a site-absolute path,
	# ignoring the prefix. So the one button the entire SSO integration
	# hangs off pointed at the top of the site, where nothing is listening.
	#
	# 308 AND NOT A REWRITE. A rewrite would leave the browser's URL at the
	# root while Stirling built its state cookie and callback from the
	# prefix -- three components disagreeing about where the app is. A real
	# redirect puts the browser on /pdf/ first, so they agree.
	#
	# The wildcard is deliberate: the bug is Spring's path handling, not the
	# name "household". A second registration would break identically.
	# {uri} is the whole path and query, so this lands on
	# /pdf/oauth2/authorization/household with any state parameters intact.
	redir /oauth2/authorization/* /pdf{uri} 308

	redir /pdf /pdf/ 308
	handle_path /pdf/* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			# THE ORIGINAL PATH, NOT THE STRIPPED ONE.
			#
			# handle_path removes the prefix before this runs, so Caddy's
			# own X-Forwarded-Uri arrived at the auth service as "/" for
			# every app in a handle_path block. Two things broke, and only
			# the harmless one was visible:
			#
			#  1. Signing in dumped you at the site root instead of the
			#     page you asked for -- /auth/?next=/ rather than
			#     ?next=/git/.
			#  2. MUCH WORSE: app_for_uri() decides per-app permissions by
			#     matching that path. Given "/" it matched nothing and
			#     returned None, which means "being on the sign-in list is
			#     the only gate" -- so the per-app toggles on /admin/people
			#     did nothing at all for /git, /portainer, /status, /tools
			#     and /pdf. Anyone who could sign in could reach Portainer,
			#     which holds the Docker socket and is root-equivalent.
			#
			# Proven by the one block that does NOT strip: /logs uses
			# `handle` and correctly produced ?next=/logs/ while every
			# handle_path app produced ?next=/ (measured 2026-08-28).
			#
			# orig_uri is the path as the browser sent it, before any
			# rewrite -- which is what both the redirect and the permission
			# check have always meant to use.
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
