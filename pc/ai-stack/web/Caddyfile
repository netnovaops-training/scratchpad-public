	# --- the log dashboard, under /grafana --------------------------------
	# Loki has been collecting since 2026-08-20 and Grafana has been running
	# beside it the whole time on 127.0.0.1:3001 with no route. The logs
	# existed; there was no way to look at them. Added 2026-08-28, the same
	# day the NUC finally started shipping its own.
	#
	# `handle`, not `handle_path`: Grafana is told to serve from /grafana
	# (GF_SERVER_SERVE_FROM_SUB_PATH) and writes that prefix into its own
	# links, so stripping it here would break every one of them -- the same
	# two-halves arrangement Gitea and Portainer already use.
	#
	# host.docker.internal because Grafana runs in the PC's OTHER compose
	# project and is published on loopback; Caddy cannot reach a sibling
	# project by service name.
	redir /grafana /grafana/ 308
	handle /grafana* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		# MOVED TO THE NUC 2026-09-06. Grafana and Loki were 689 MiB on
		# the machine whose constraint is memory, and a log server
		# belongs on the box that stays up rather than the one whose
		# outages you want the logs to explain.
		#
		# 3003 AND NOT GRAFANA'S OWN PORT. Grafana trusts X-Auth-Email,
		# creates unknown addresses, and makes them ADMIN. On the PC it
		# was on loopback so only Caddy could reach it; on the NUC the
		# port has to be on the LAN. 3003 is an nginx sidecar that
		# blanks that header unless the connection came from this
		# machine -- see logging/nuc/grafana-proxy.nginx.conf. Pointing
		# this at Grafana directly would put an admin account on the
		# household log server one curl away from any device in the
		# house. (3003, not 3001: Uptime Kuma holds 3001 on the NUC.)
		reverse_proxy 192.168.1.86:3003 {
			import appproxy
		}
	}

	# --- paperless-ngx, under /paperless -----------------------------------
	# Scan a document, get a searchable archive. Started 2026-08-28 -- it had
	# been defined but unstartable: no Redis (which Paperless requires, not
	# prefers) and a media volume pointing at a Synology share that was never
	# mounted on this box.
	#
	# `handle`, not `handle_path`: PAPERLESS_FORCE_SCRIPT_NAME=/paperless makes
	# Paperless write that prefix into its own links, so stripping it here
	# would break every one. Same two-halves arrangement as Gitea, Portainer
	# and Grafana.
	#
	# Its port is published on the NUC's LAN address, not loopback -- this
	# Caddy runs on the other machine and could not otherwise reach it. Port
	# 8000 is not forwarded on the router, so from outside the house this
	# block, and the sign-in in front of it, remain the only way in.
	redir /paperless /paperless/ 308
	# --- SHARE LINKS, AND ONLY SHARE LINKS -----------------------------------
	#
	# Jason, 2026-09-06: "I want this so that even if she shares with chat
	# gpt or my mom sets up information it hits to the person needing it."
	#
	# A share link is meant for somebody outside the household -- a chat, a
	# supervisor, a nominator -- who cannot complete an SSO sign-in and
	# should not need an account. Under the block below it 303'd them to a
	# login they could never pass.
	#
	# THIS IS THE NARROWEST HOLE THAT DOES THE JOB, and it needs to be,
	# because the archive holds 85 documents including psychiatric
	# evaluations, medical progress notes and a 1099-R. What is exempt:
	#
	#   /paperless/share/<slug>   a document somebody deliberately shared
	#
	# What is NOT: the document list, search, the API, the dashboard, and
	# every other path -- all still behind forward_auth below. There is no
	# route from a share link to browsing anything else, because the only
	# thing this block can reach is a slug that already exists.
	#
	# THE SLUG IS THE CREDENTIAL. Paperless mints a random one per link and
	# can expire it. Anyone holding the URL can open that ONE document, so
	# treat a share link like the document itself -- and set an expiry.
	# Ordered BEFORE the gated block: Caddy takes the first match.
	handle /paperless/share/* {
		reverse_proxy 192.168.1.86:8000 {
			import appproxy
			# No X-Auth-Email is set here, deliberately. Paperless treats a
			# share link as anonymous-by-design; sending an identity would
			# make the link act as whoever Caddy last saw.
			header_up -X-Auth-Email
		}
	}

	handle /paperless* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy 192.168.1.86:8000 {
			import appproxy
		}
	}

	# --- /dashboard -- one page listing every ops tool ----------------------
	# Added 2026-08-28. Cards only: it LINKS to /status, /logs, /grafana,
	# /portainer, /paperless, /git, /tools and /pdf, and moves none of them.
	# Re-pathing those under /dashboard/* would mean changing five apps' base
	# URLs and rebuilding IT-Tools from source, to change what the address bar
	# says. See dashboard_sections() in rust/landing for the full reasoning.
	#
	# Served by the landing app, but unlike the rest of that app it sits behind
	# forward_auth -- the front page is public, and a menu of the house's
	# admin tools is not.
	# --- /portfolio: public, deliberately -------------------------------------
	# NO forward_auth. It exists to be read by somebody who has never signed in
	# and never will, which is the one page on this host where that is the point.
	# The previous front page, kept reachable after the portfolio took over /.
	# --- the garden's second pass -------------------------------------------
	# MUST COME BEFORE `handle /garden*` BELOW. Caddy tries handle blocks in
	# the order they are written, not longest-match-first, so putting this
	# after would mean /garden* swallowed /garden-review and the page 404'd
	# through the proxy while working perfectly on the LAN.
	#
	# The moderation queue for Robin's catalogue: what he has approved, before
	# it settles. Behind the household sign-in like every other instrument
	# panel, and the service checks the address again on its own side --
	# being signed in to the house is not the same as being this
	# catalogue's administrator.
	#
	# handle_path strips the prefix, so the service sees /review and
	# /api/review and does not need to know where it is mounted. The page
	# derives the mount from its own URL for the links it writes.
	handle_path /garden-review* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		# RETIRED 2026-10-25: Robin's Garden is not served from here.
		respond "Robin's Garden moved." 410
	}
