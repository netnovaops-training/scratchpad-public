# =============================================================================
#  tandoor.home.example.net -- the same service that lived on
#  example.org:9445, moved to a subdomain on plain 443 so the
#  router forward for :9445 can close (2026-08-31: the router goes down to
#  80 and 443 and nothing else). The old port block remains above but the
#  router no longer forwards its port, so it serves only the LAN.
# =============================================================================
tandoor.home.example.net {
	import common

	redir /auth /auth/ 308
	handle /auth/* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	# --- kitshn (and any other real Tandoor client), unauthenticated at
	# THIS layer, on purpose -----------------------------------------------
	# Jason's own request (2026-08-24): set up the real kitshn app
	# (play.google.com/store/apps/details?id=de.kitshn.android) for Mama
	# and Casey. A native app has no way to hold the site's own SSO cookie --
	# it logs in directly against Tandoor's own real accounts (Settings >
	# API Tokens, or its normal username/password), which is a perfectly
	# real gate on its own. Putting forward_auth in front of THAT login
	# request would 401 it before Tandoor ever saw it -- confirmed live
	# this session that forward_auth gates the whole port unconditionally,
	# and the @needs_handoff redirect below only fires for a browser
	# (`Accept: text/html`), never a JSON API call, so a native app would
	# have gotten forward_auth's bare 401 with no way to recover from it.
	# /media/* is exempted too -- recipe/step photos the app needs to
	# actually show a recipe, same reasoning. Tandoor's own account system
	# (already real, already provisioned for Jason/Mama/Casey) is what
	# decides who sees what through here, exactly as it's designed to.
	handle /api/* {
		request_body {
			max_size 64MB
		}
		reverse_proxy tandoor:80 {
			import appproxy
		}
	}
	handle /media/* {
		reverse_proxy tandoor:80 {
			import appproxy
		}
	}

	handle {
		# Recipe photos again -- same allowance as Mealie's own block.
		request_body {
			max_size 64MB
		}

		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			# THE ORIGINAL PATH, NOT THE STRIPPED ONE.
			#
			# handle_path removes the prefix before this runs, so Caddy's
			# own X-Forwarded-Uri arrived at the auth service as "/" for
			# every app in a handle_path block. Two things broke, and only
			# the harmless one was visible:
			#
			#  1. Signing in dumped you at the site root instead of the
			#     page you asked for -- /auth/?next=/ rather than
			#     ?next=/git/.
			#  2. MUCH WORSE: app_for_uri() decides per-app permissions by
			#     matching that path. Given "/" it matched nothing and
			#     returned None, which means "being on the sign-in list is
			#     the only gate" -- so the per-app toggles on /admin/people
			#     did nothing at all for /git, /portainer, /status, /tools
			#     and /pdf. Anyone who could sign in could reach Portainer,
			#     which holds the Docker socket and is root-equivalent.
			#
			# Proven by the one block that does NOT strip: /logs uses
			# `handle` and correctly produced ?next=/logs/ while every
			# handle_path app produced ?next=/ (measured 2026-08-28).
			#
			# orig_uri is the path as the browser sent it, before any
			# rewrite -- which is what both the redirect and the permission
			# check have always meant to use.
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}

		# --- the sign-in hand-off ---------------------------------------------
		# REPOINTED 2026-09-04. This used to send a cookie-less browser to
		# https://example.org/kitchen/library, where Kitchen logged in
		# to Tandoor on their behalf using a per-person password it keeps in its
		# own tandoor_users table (Kitchen/app/handoff_tandoor.py).
		#
		# THAT MECHANISM IS DEAD, and not because of this change: the accounts it
		# holds passwords for no longer exist. Tandoor had been silently running
		# on SQLite, in a file inside its own container, on no volume -- see
		# DB_ENGINE in docker-compose.web.yml for the full account -- and the
		# 2026-08-31 restart took every account and every recipe with it.
		#
		# Tandoor now signs people in against the household's own OIDC issuer,
		# so the hand-off is one hop instead of three: this redirect starts the
		# flow, SOCIALACCOUNT_LOGIN_ON_GET makes allauth skip its confirmation
		# page, and the issuer already holds the signed-in cookie and bounces
		# straight back. No password is stored anywhere for it.
		#
		# `not path /accounts/*` IS LOAD-BEARING. Without it this matcher eats
		# the very flow it is trying to start: /accounts/oidc/household/login/
		# and its /login/callback/ are both HTML GETs that arrive with no
		# sessionid cookie -- the callback is what SETS that cookie. The symptom
		# is a redirect loop that never reaches Tandoor at all.
		@needs_handoff {
			not header_regexp Cookie "sessionid="
			not path /accounts/*
			method GET
			header Accept *text/html*
		}
		redir @needs_handoff /accounts/oidc/household/login/?process=login&next={uri} 302

		reverse_proxy tandoor:80 {
			import appproxy

			# Tandoor's own AI import calls LiteLLM the same way Mealie's does
			# -- same long-read-timeout reasoning as the Mealie block above.
		}
	}
}

# =============================================================================
#  status.home.example.net -- Uptime Kuma, finally reachable.
#
#  /status NEVER WORKED, and the reason turned out to be structural: Kuma
#  redirects / to /dashboard and serves every asset root-anchored -- it does
#  not support living under a subpath, full stop. So it gets what the other
#  subpath-refuseniks got in 2026-08-31's subdomain wave: its own hostname.
#
#  NOT behind forward_auth, and here that is a technical necessity rather
#  than a choice: the household cookie lives on example.org and a
#  duckdns hostname is a different registrable domain -- the cookie will
#  never arrive here. Kuma's own login guards it instead (admin account
#  created 2026-08-31, the same hour this block was -- before that, Kuma had
#  NO admin and /setup would have handed the instance to its first visitor).
# =============================================================================
status.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	# The cookie-bridge redemption door: /sso/bridge on the main site mints a
	# one-minute code and sends the browser here; the auth service redeems it
	# and sets the session cookie FOR THIS HOST. See rust/auth/src/bridge.rs.
	handle /__sso* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	handle {
		# The same household gate as the main site's apps -- workable on a
		# foreign domain only because of the bridge above.
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
			header_up X-Forwarded-Host {host}
		}
		# Kuma's own login is DISABLED (its documented reverse-proxy mode) --
		# the household sign-in above is the only gate, which is the point.
		reverse_proxy 192.168.1.86:3001
	}
}

# =============================================================================
#  llm.home.example.net -- LiteLLM's API from outside the house.
#
#  Jason's rule made this shape: access from anywhere, ports for nothing.
#  The router forward for 4000 is gone; this subdomain rides 443 like
#  everything else. NOT behind the household SSO because its clients are
#  programs, not browsers -- LiteLLM enforces its own bearer API keys on
#  every route, which is the correct lock for an API. Nothing answers here
#  without a key.
# =============================================================================
#  homebox.home.example.net -- warranties, receipts, renewals.
#
#  Jason, 2026-09-10: "something that reminds me that something's going to
#  expire and be reminded to renew it".
#
#  A HOSTNAME RATHER THAN A PATH, deliberately. Homebox has no subpath
#  support: under /homebox/ its Nuxt baseURL and its /api/v1 and websocket
#  routes all have to be rewritten with sub_filter, and v0.23.0 shipped a
#  base-URL regression on top of that. Stirling already taught this house
#  that lesson under /pdf/. DuckDNS resolves every subdomain to the same
#  address, so the hostname is free and the whole class of problem goes away.
#
#  Gated by the household, via the cookie bridge -- same arrangement as
#  status. Homebox keeps its own login behind that; it has no OIDC, so two
#  doors is the honest description until it does.
# =============================================================================
#  money.home.example.net -- MoneyMatter, self-hosted.
#
#  Jason, 2026-09-10: "I want to use https://moneymatter.app/ ... I want to
#  take all the account info like paystubs there and bank statements", then
#  "i want it hosted on my pcv".
#
#  SELF-HOSTED RATHER THAN THE SAAS, and that was the point of checking: it
#  is AGPL-3.0 with published images, so the paystubs and bank statements
#  this will hold never leave the house. The hosted version would also have
#  needed his password, which is not a thing to hand over.
#
#  A HOSTNAME, not a path. Third app today to earn one -- the frontend is a
#  Vue SPA with no base-path setting, so under /money its assets would all
#  404, exactly as Audiobookshelf's did under /listen.
#
#  Reached over Docker's own network, not a host port. Upstream names the
#  stack's network `budget-tracker` and aliases the frontend to match,
#  precisely so an outside reverse proxy can join; Caddy is a member (see
#  docker-compose.web.yml) so nothing needs publishing on the machine.
#
#  IT HAS NO OIDC. The household gate is in front, and MoneyMatter keeps its
#  own login behind it -- two doors, honestly described, same as Homebox was
#  before 0.22.1 gave it SSO.
# =============================================================================
#  dj.home.example.net -- the DJ stream. PUBLIC, NO GATE.
#
#  Jason, 2026-09-10: "broadcast my traktor pro 4 session with a webcam to dj
#  subdomain with a live and request button", and he chose public knowingly
#  when asked.
#
#  THIS IS THE ONLY WHOLE SITE HERE WITH NO forward_auth. /s/ and /exam/ are
#  ungated PATHS, and both are guarded by an unguessable token that names one
#  record. This is a hostname anybody can open, which is the point -- a stream
#  nobody can watch is not a stream. Worth being deliberate about rather than
#  arriving at: nothing else on this domain should be added under this block.
#
#  RTMP INGEST IS NOT HERE AND MUST NOT BE. OBS pushes to 192.168.1.86:1935
#  over the LAN. That port is bound to the LAN address in compose and there is
#  no router forward for it. An open ingest port is how somebody else's video
#  ends up on your site.
#
#  Two things Jason accepted with "public": every 720p viewer is roughly
#  2-3 Mbps of household UPLOAD, so a dozen of them will saturate a domestic
#  connection -- and the viewers see it stutter before the DJ does. And a
#  self-hosted public stream carries none of the music licensing that Twitch
#  and Mixcloud have negotiated.
# =============================================================================
dj.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	# Owncast is a live video server: HLS segments, a websocket for chat, and
	# a REST API the page polls for whether the stream is up. reverse_proxy
	# upgrades websockets on its own; what it must NOT do is buffer, so no
	# compression and no body limit on this one.
	reverse_proxy 192.168.1.86:8095 {
		header_up X-Forwarded-Host {host}
		# Long timeouts: an HLS viewer holds a connection open for the whole
		# set, and the chat socket for longer.
		transport http {
			read_timeout 12h
			write_timeout 12h
		}
	}
}

# =============================================================================
money.home.example.net {
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	# The cookie-bridge redemption door: the session cookie belongs to
	# example.org, and this is how a foreign host gets its own.
	handle /__sso* {
		reverse_proxy https://192.168.1.86 {
			import nuc_signin
		}
	}

	handle {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
			header_up X-Forwarded-Host {host}
		}
		# Bank statements and CSVs are uploaded here.
		request_body {
			max_size 64MB
		}
		reverse_proxy budget-tracker:80 {
			import appproxy
		}
	}
}

