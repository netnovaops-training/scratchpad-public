	# --- the recipe importer, under /kitchen ---------------------------------
	# Paste a link, get a step-by-step guide with the portions scaled. The
	# recipe LIBRARY is Mealie and lives on port 9443 (see the block at the
	# bottom of this file) -- this is the front door that reads pages, and the
	# thing that hands out Mealie sessions so nobody meets a second login.
	#
	# forward_auth, like /mama and /casey: the app has no login of its own and
	# never sees an unauthenticated request. It reads X-Auth-Email only to know
	# who imported what, and whether they are you.
	#
	# The landing card and everything else call it "Recipes"; the app and the
	# container are called "kitchen". Rather than rename one to match the
	# other, both names work and one of them is the real address.
	redir /recipes /kitchen/ 308
	redir /recipes/ /kitchen/ 308
	redir /kitchen /kitchen/ 308

	# --- /files: each person sees what is theirs -----------------------------
	# Jason, 2026-09-06. Same forward_auth shape as every other app: the
	# app has no login of its own and refuses outright if X-Auth-Email is
	# missing, rather than falling back to some default user -- so being
	# behind this block is not a convenience, it is the whole identity
	# mechanism. See ai-stack/files/app/main.py's who().
	redir /files /files/ 308
	handle_path /files/* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			# The original path, not the stripped one -- see the long note
			# in the /recipe block below for what breaks otherwise.
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy files:8000 {
			import appproxy
			header_up X-Forwarded-Prefix /files
		}
	}

	# --- /dl: big files, off this machine, from anywhere ---------------------
	# Jason, 2026-09-23: "Allow me to download it off my PC." Renders,
	# exports and archives are too large to hand over in a chat window and
	# have no business being public, so they sit in web/private and come
	# out through here.
	#
	# BEHIND THE SAME SIGN-IN AS EVERY OTHER INSTRUMENT PANEL. An 82MB file
	# on a domestic upload is worth gating for bandwidth alone, never mind
	# that these are family photographs and personal work.
	#
	# `file_server` WITH NO `browse`, and that is deliberate. A directory
	# listing here would be a catalogue of everything he has ever exported.
	# Without it a file must be asked for by its exact name, which is how
	# the rest of this file has behaved since `file_server browse` over
	# ../Legacy turned out to be serving .env.
	#
	# root, NOT handle_path: the strip and the root would both remove the
	# prefix and /dl/x.mp4 would be looked up as /srv/private/../x.mp4.
	handle /dl/* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		root * /srv
		# Content-Disposition, so a browser SAVES the file instead of
		# opening an 82MB video in a tab it then has to stream.
		header Content-Disposition "attachment"
		header Cache-Control "private, max-age=0, must-revalidate"
		file_server
	}

	# --- the standalone recipe app, under /recipe -----------------------------
	# Jason's own request (2026-08-24): browse, one recipe, random pick, meal
	# planning AND the pantry picker, all on one page at /recipe, nothing
	# that sends anyone off to Tandoor's own UI or back into Kitchen -- see
	# recipe-app/app/config.py for the full reasoning. Superseded TWO earlier
	# versions of this block, both real: first a plain redirect to Tandoor's
	# own ":9445/view/recipe/{id}" (from when kitshn -- the real third-party
	# Tandoor app, play.google.com/store/apps/details?id=de.kitshn.android --
	# first came up), then Jason's own correction that /recipe should be an
	# actual in-house app, not a redirect anywhere. Same forward_auth shape
	# as /kitchen's own block just below -- the app has no login of its own,
	# same reasoning as everywhere else in this file.
	# --- /pi: digits of pi, cross-checked and fingerprinted (2026-11-08) ------
	# Same gate as /recipe (see the long note there about X-Forwarded-Uri).
	redir /pi /pi/ 308
	handle_path /pi/* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy pi:8020 {
			import appproxy
			header_up X-Forwarded-Prefix /pi
		}
	}

	redir /recipe /recipe/ 308
	handle_path /recipe/* {
		forward_auth https://192.168.1.86 {
			import nuc_gate
			uri /verify
			copy_headers X-Auth-Email
			# THE ORIGINAL PATH, NOT THE STRIPPED ONE.
			#
			# handle_path removes the prefix before this runs, so Caddy's
			# own X-Forwarded-Uri arrived at the auth service as "/" for
			# every app in a handle_path block. Two things broke, and only
			# the harmless one was visible:
			#
			#  1. Signing in dumped you at the site root instead of the
			#     page you asked for -- /auth/?next=/ rather than
			#     ?next=/git/.
			#  2. MUCH WORSE: app_for_uri() decides per-app permissions by
			#     matching that path. Given "/" it matched nothing and
			#     returned None, which means "being on the sign-in list is
			#     the only gate" -- so the per-app toggles on /admin/people
			#     did nothing at all for /git, /portainer, /status, /tools
			#     and /pdf. Anyone who could sign in could reach Portainer,
			#     which holds the Docker socket and is root-equivalent.
			#
			# Proven by the one block that does NOT strip: /logs uses
			# `handle` and correctly produced ?next=/logs/ while every
			# handle_path app produced ?next=/ (measured 2026-08-28).
			#
			# orig_uri is the path as the browser sent it, before any
			# rewrite -- which is what both the redirect and the permission
			# check have always meant to use.
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		reverse_proxy recipe-app:8004 {
			import appproxy
			header_up X-Forwarded-Prefix /recipe
		}
	}

	# --- /recipe-gemini, kept only so old links still land -------------------
	# The A/B twin lived here from 2026-09-04 until Jason called it on
	# 2026-09-06 ("make gemnie-recipe /recipe"). /recipe IS the Gemini one
	# now -- same container, one env flag -- so this block was an exact copy
	# of the one above, forward_auth comment and all, pointing at a second
	# container of the same image. Both are gone. A redirect costs two lines
	# and means a bookmark or an open tab still works.
	#
	# handle_path, NOT a plain redir: handle_path strips the prefix before
	# the inner directive runs, so {uri} here is the REST of the path plus
	# any query ("/28?x=1"), and the target comes out /recipe/28?x=1. A
	# plain `redir /recipe-gemini/* /recipe{uri}` looks equivalent and is
	# not -- {uri} would still carry the old prefix and send people to
	# /recipe/recipe-gemini/28.
	redir /recipe-gemini /recipe/ 308
	handle_path /recipe-gemini/* {
		redir * /recipe{uri} 308
	}

