# =============================================================================
#  F5-TTS TRIAL image (2026-09-13). Jason: "the next voice TTS model I can
#  use that's a step up".
#
#  Layered ON TOP of the approved voice image, same as Dockerfile.turbo, so
#  the engines Jason's ear has already certified cannot shift underneath him.
#  Their image is untouched; this one only adds f5-tts.
#
#  WHY F5-TTS AND NOT THE BIGGER NAMES
#    F5-TTS         ~3GB VRAM. Documented quality leader for English and
#                   specifically better than Chatterbox on LONG-FORM prosody
#                   -- which is the original complaint (the tribute narration
#                   read as robotic). Reference clip 5-15s, which is exactly
#                   what trim-references.py now produces.
#    Qwen3-TTS 1.7B >=12GB on a 12GB card, and documented run-to-run timbre
#                   drift. The opposite of the accuracy being asked for.
#    Voxtral TTS    16GB. Does not fit.
#
#  WHY THE DEPENDENCY LIST IS SPELLED OUT INSTEAD OF `pip install f5-tts`
#  Two of its declared dependencies must not be installed here:
#
#    torch/torchaudio  the base image pins 2.6.0+cu124. Letting pip resolve
#                      f5-tts's tree freely will happily satisfy
#                      "torch>=2.0.0" with a CPU wheel and silently cost the
#                      GPU -- the model would still run, just thirty times
#                      slower, with nothing in the logs saying why.
#    gradio>=6.15      a web demo UI this server has no use for, and a large
#                      thing to drag into an image that is already 12GB.
#
#  THE LIST IS EVERY DECLARED DEPENDENCY EXCEPT THOSE TWO. Two earlier
#  attempts tried to be clever -- first a hand-guessed minimal set (missed
#  hydra-core), then "everything except the training and experiment-tracking
#  packages" (missed matplotlib, then wandb). That theory is simply wrong:
#  f5_tts.api imports the training module chain, so matplotlib and wandb are
#  import-time requirements whatever their names suggest. Guessing which
#  dependencies a package "really" needs is a losing game; the only two worth
#  excluding are the two that would actively do damage.
# =============================================================================
FROM ai-stack/voice:latest

RUN pip install --no-cache-dir \
        "accelerate>=0.33.0" \
        bitsandbytes \
        cached_path \
        click \
        datasets \
        "ema_pytorch>=0.5.2" \
        "hydra-core>=1.3.0" \
        librosa \
        matplotlib \
        pydub \
        pypinyin \
        rjieba \
        safetensors \
        soundfile \
        tomli \
        torchdiffeq \
        "tqdm>=4.65.0" \
        transformers_stream_generator \
        unidecode \
        vocos \
        wandb \
        "x_transformers>=1.31.14" \
 && pip install --no-cache-dir --no-deps f5-tts \
 # Prove the GPU build survived. If pip swapped torch for a CPU wheel this
 # prints cuda None, and the build should be looked at rather than shipped.
 && python -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda)" \
 # And prove the import path the server actually uses resolves, so a missing
 # dependency fails HERE rather than at the first request.
 && python -c "from f5_tts.api import F5TTS; print('f5_tts.api imports OK')"
